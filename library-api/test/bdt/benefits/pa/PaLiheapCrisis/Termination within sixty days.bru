meta {
  name: Termination within sixty days
  type: http
  seq: 10
}

post {
  url: {{host}}/benefits/pa/liheap-crisis
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPennsylvania": true,
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": {
        "paLiheap": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "pecoCap": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "pgwCrp": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "phlTap": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "phlSeniorWater": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "pecoMeaf": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "paWap": {
          "annualIncome": 20000,
          "householdSize": 1
        }
      },
      "heating": {
        "responsibleForSeparatePrimaryHeatingCosts": true,
        "heatIncludedInRent": false,
        "responsibleForHeatingSystemElectricity": false,
        "rentBasedOnIncome": false,
        "equipmentBroken": false,
        "fuelLinesLeaking": false,
        "fuelDaysRemaining": 30,
        "heatingServiceDisconnected": false,
        "terminationNotice": true,
        "daysUntilTermination": 60,
        "terminationPermitted": true,
        "crisisResolutionVerified": true
      },
      "people": [
        {
          "citizenshipStatus": "us-citizen",
          "excludedFromLiheapHousehold": false
        }
      ]
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq true
}
