  <dmn:itemDefinition id="_97DE4201-D94F-4D0E-B2F7-8A47D2DD6711" name="tHousehold" isCollection="false">
    <dmn:description>Minimal local projection for WapIncomeOrCategorical. Reuse the canonical field meanings in BDT.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_02B70FA9-E109-407C-82F2-EAF819CA7AAE" name="wapCategoricalEnrollment" isCollection="false">
      <dmn:typeRef>tWapCategoricalEnrollment</dmn:typeRef>
