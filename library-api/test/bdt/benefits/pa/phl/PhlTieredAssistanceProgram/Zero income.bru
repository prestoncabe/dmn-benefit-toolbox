meta {
  name: Zero income
  type: http
  seq: 6
}

post {
  url: {{host}}/benefits/pa/phl/tiered-assistance-program
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": {
        "phlTap": {
          "annualIncome": 0,
          "householdSize": 1
        }
      },
      "waterHardship": {
        "claimed": false
      },
      "utilityAccounts": {
        "pwd": {
          "residential": true,
          "applicantIsCustomer": true,
          "occupiesServiceAddress": true
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq true
}
