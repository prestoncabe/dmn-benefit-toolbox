meta {
  name: Approved hardship without numeric income
  type: http
  seq: 9
}

post {
  url: {{host}}/checks/internal/tap-income-or-hardship
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "asOfDate": "2026-10-15",
      "incomeAssessments": [],
      "waterHardship": {
        "claimed": true,
        "approved": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
