meta {
  name: Income based heat with operating electricity
  type: http
  seq: 4
}

post {
  url: {{host}}/checks/utilities/liheap-crisis-heating-responsibility
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "heating": {
        "responsibleForSeparatePrimaryHeatingCosts": false,
        "heatIncludedInRent": true,
        "rentBasedOnIncome": true,
        "responsibleForHeatingSystemElectricity": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
