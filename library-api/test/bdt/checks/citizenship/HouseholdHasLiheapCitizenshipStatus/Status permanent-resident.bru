meta {
  name: Status permanent-resident
  type: http
  seq: 5
}

post {
  url: {{host}}/checks/citizenship/household-has-liheap-citizenship-status
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "people": [
        {
          "citizenshipStatus": "permanent-resident",
          "excludedFromLiheapHousehold": false
        }
      ]
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
