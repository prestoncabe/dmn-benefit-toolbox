meta {
  name: Reweatherization exception approved
  type: http
  seq: 12
}

post {
  url: {{host}}/checks/residence/wap-dwelling
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "dwelling": {
        "occupiesHome": true,
        "tenure": "owner",
        "buildingEligibilityVerified": true,
        "previouslyWeatherized": true,
        "lastWeatherizationDate": "2020-01-01",
        "reweatherizationExceptionApproved": true
      },
      "simpleChecks": {}
    },
    "parameters": {
      "asOfDate": "2026-10-15"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
