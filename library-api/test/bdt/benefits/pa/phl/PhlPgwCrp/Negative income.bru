meta {
  name: Negative income
  type: http
  seq: 7
}

post {
  url: {{host}}/benefits/pa/phl/pgw-crp
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": {
        "pgwCrp": {
          "annualIncome": -1,
          "householdSize": 1
        }
      },
      "utilityAccounts": {
        "pgw": {
          "residential": true,
          "applicantIsCustomer": true,
          "occupiesServiceAddress": true,
          "previouslyInCrp": false
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq null
}
