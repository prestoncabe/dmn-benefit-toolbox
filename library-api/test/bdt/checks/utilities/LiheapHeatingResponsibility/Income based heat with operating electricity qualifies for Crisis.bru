meta {
  name: Income based heat with operating electricity qualifies for Crisis
  type: http
  seq: 18
}

post {
  url: {{host}}/checks/utilities/liheap-heating-responsibility
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "heating": {
        "responsibleForSeparatePrimaryHeatingCosts": false,
        "heatIncludedInRent": true,
        "rentBasedOnIncome": true,
        "responsibleForHeatingSystemElectricity": true
      }
    },
    "parameters": {
      "crisis": true
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
