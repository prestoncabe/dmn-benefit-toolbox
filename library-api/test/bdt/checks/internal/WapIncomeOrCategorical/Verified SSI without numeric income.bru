meta {
  name: Verified SSI without numeric income
  type: http
  seq: 4
}

post {
  url: {{host}}/checks/internal/wap-income-or-categorical
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "asOfDate": "2026-10-15",
      "incomeAssessments": [],
      "household": {
        "wapCategoricalEnrollment": {
          "benefit": "SSI",
          "verified": true,
          "verifiedOn": "2026-10-15",
          "validThrough": "2027-10-15"
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
