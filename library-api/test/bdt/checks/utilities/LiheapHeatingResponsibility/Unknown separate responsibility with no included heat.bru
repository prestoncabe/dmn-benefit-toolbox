meta {
  name: Unknown separate responsibility with no included heat
  type: http
  seq: 12
}

post {
  url: {{host}}/checks/utilities/liheap-heating-responsibility
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "heating": {
        "heatIncludedInRent": false
      }
    },
    "parameters": {
      "crisis": false
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq null
}
