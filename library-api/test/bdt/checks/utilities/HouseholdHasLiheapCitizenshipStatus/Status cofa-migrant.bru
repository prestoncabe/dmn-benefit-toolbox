meta {
  name: Status cofa-migrant
  type: http
  seq: 14
}

post {
  url: {{host}}/checks/utilities/household-has-liheap-citizenship-status
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "household": {
        "hasUsCitizen": false,
        "liheapNoncitizenStatuses": [
          "cofa-migrant"
        ]
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
