    </dmn:knowledgeRequirement>
    <dmn:context id="_C9774983-7865-4C35-9A7E-D04FC17A7E20">
      <dmn:contextEntry>
        <dmn:variable id="_07783307-8A66-432C-BC83-11A4B3AB94FD" name="Income" typeRef="boolean" />
