<dmn:definitions xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:kie="https://kie.org/dmn/extensions/1.0" id="_8F26272A-C871-40E7-887E-4AA84F9B2916" name="LiheapCashNotReceived" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_789A4EE7-22B1-47EB-BDDC-268FFB9E1C0A" xmlns="https://kie.apache.org/dmn/_789A4EE7-22B1-47EB-BDDC-268FFB9E1C0A" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/" xmlns:included1="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" xmlns:included2="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C">
  <dmn:description>Exclude an ordinary LIHEAP Cash receipt in the current federal program year.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="FY2027 LIHEAP final state plan — Appendix B, §§601.31, 601.41, 601.81–84" url="https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf" />
  </dmn:extensionElements>
  <dmn:import id="_BAC7FDB2-5094-4B63-BA08-60A618B93D79" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:import id="_212F493C-699C-457D-8E82-A6C0CE91CD90" name="Utilities" namespace="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C" locationURI="Utilities.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:itemDefinition id="_F858055F-70FE-4F66-96A3-8FC4D977B55B" name="tSituation" isCollection="false">
    <dmn:description>Minimal local projection for LiheapCashNotReceived. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_EC1E0A73-C944-4F83-9390-FCAC3D8F231F" name="asOfDate" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_50E1F672-8FE7-4584-BA6A-E5DA1F65ECFA" name="assistanceHistory" isCollection="false">
      <dmn:typeRef>tAssistanceHistory</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_D4F47CCE-9D55-4F6B-A775-B651E923B874" name="tGrantHistory" isCollection="false">
    <dmn:description>Minimal local projection for LiheapCashNotReceived. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_DCA1B02F-07C7-4519-8CA9-068CB749A30B" name="received" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_B3796043-9213-4BED-B4F6-6D53C19848FC" name="lastReceivedDate" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_31FF75DB-EE50-44FF-88BD-022955586ABE" name="tAssistanceHistory" isCollection="false">
    <dmn:description>Minimal local projection for LiheapCashNotReceived. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_4841A483-2096-4B2C-910C-0D39008D2938" name="paLiheap" isCollection="false">
      <dmn:typeRef>tGrantHistory</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_B0BD52F8-BA40-4541-B10D-7ED4E02E7EF3" name="LiheapCashNotReceivedService">
    <dmn:extensionElements />
    <dmn:variable id="_94142168-336E-4F4D-944C-481AE3BE0C7A" name="LiheapCashNotReceivedService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_151B8A41-E43C-4048-ACA5-3700977E52A6" />
    <dmn:inputData href="#_3B76752A-D10D-4B91-941A-BEAE0822A90B" />
  </dmn:decisionService>
  <dmn:decision id="_151B8A41-E43C-4048-ACA5-3700977E52A6" name="checkResult">
    <dmn:description>Use asOfDate or today(), then October 1 of the applicable October–September program year. An assistanceHistory.paLiheap lastReceivedDate on/after that date disqualifies an ordinary Cash application. received=false passes; a missing record or received answer is unknown. Unknown or future receipt dates remain unresolved rather than proving no receipt. Current enrollment is not grant history. Supplement awards require agency handling; Crisis does not use this Cash exclusion. Policy review 2026-10-15.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="FY2027 LIHEAP final state plan — Appendix B, §§601.31, 601.41, 601.81–84" url="https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf" />
    </dmn:extensionElements>
    <dmn:variable id="_26E758F3-616E-4415-90A2-D406A7FD851F" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_1E4D2DA8-264C-44EE-91DC-31621323E814">
      <dmn:requiredInput href="#_3B76752A-D10D-4B91-941A-BEAE0822A90B" />
    </dmn:informationRequirement>
    <dmn:context id="_F0E0AE17-1570-41E8-B735-BD895E09AEEC">
      <dmn:contextEntry>
        <dmn:variable id="_5E24A665-D2FB-48E9-A811-55E6998E662C" name="comparisonDate" typeRef="date" />
        <dmn:literalExpression id="_5E499DA7-74F7-4EBD-BDDE-696ED5A8FBCC">
          <dmn:text>if situation.asOfDate = null then today() else situation.asOfDate</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_1B25CCA3-2892-42B6-85F1-7C88AC96B641" name="seasonStart" typeRef="date" />
        <dmn:literalExpression id="_C10E19F7-1AE3-4805-9415-9461EC2F3F44">
          <dmn:text>date(if comparisonDate.month &gt;= 10 then comparisonDate.year else comparisonDate.year - 1, 10, 1)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_7D6920F5-4837-4D64-B842-69361B39A800" name="grant" typeRef="tGrantHistory" />
        <dmn:literalExpression id="_9513CE61-6FA4-4516-823B-0EE36B314070">
          <dmn:text>if situation.assistanceHistory = null then null else situation.assistanceHistory.paLiheap</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_F6C2C6F8-34F6-4A79-B9D8-AED300F04ECB">
          <dmn:text>if grant = null or grant.received = null then null else if grant.received = false then true else if grant.lastReceivedDate = null or date(grant.lastReceivedDate) &gt; comparisonDate then null else date(grant.lastReceivedDate) &lt; seasonStart</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:inputData id="_3B76752A-D10D-4B91-941A-BEAE0822A90B" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_E994AB95-3A51-456B-9AFF-067ACE382BD2" name="situation" typeRef="tSituation" />
  </dmn:inputData>
