meta {
  name: Fuel exactly fifteen days
  type: http
  seq: 8
}

post {
  url: {{host}}/benefits/pa/liheap-crisis
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPennsylvania": true,
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": {
        "paLiheap": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "pecoCap": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "pgwCrp": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "phlTap": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "phlSeniorWater": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "pecoMeaf": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "paWap": {
          "annualIncome": 20000,
          "householdSize": 1
        }
      },
      "heating": {
        "liheapArrangementVerified": true,
        "primaryCostResponsibility": "direct",
        "secondaryCostResponsibility": "none",
        "rentBasedOnIncome": false,
        "equipmentBroken": false,
        "fuelLinesLeaking": false,
        "fuelDaysRemaining": 15,
        "heatingServiceDisconnected": false,
        "terminationNotice": false,
        "daysUntilTermination": 90,
        "terminationPermitted": false,
        "crisisResolutionVerified": true
      },
      "household": {
        "hasLiheapEligibleMember": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq false
}
