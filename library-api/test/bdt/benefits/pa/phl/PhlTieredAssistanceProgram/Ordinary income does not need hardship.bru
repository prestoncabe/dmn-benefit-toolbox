meta {
  name: Ordinary income does not need hardship
  type: http
  seq: 25
}

post {
  url: {{host}}/benefits/pa/phl/tiered-assistance-program
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": {
        "paLiheap": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "pecoCap": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "pgwCrp": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "phlTap": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "phlSeniorWater": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "pecoMeaf": {
          "annualIncome": 20000,
          "householdSize": 1
        },
        "paWap": {
          "annualIncome": 20000,
          "householdSize": 1
        }
      },
      "waterHardship": {},
      "utilityAccounts": {
        "pwd": {
          "residential": true,
