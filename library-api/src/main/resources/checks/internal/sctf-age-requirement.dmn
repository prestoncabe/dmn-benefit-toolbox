<?xml version="1.0" encoding="UTF-8" ?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns="https://kie.apache.org/dmn/_6DD53443-571F-4F35-9881-5F7091F9CE59" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/" xmlns:kie="https://kie.org/dmn/extensions/1.0" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:included1="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" xmlns:included2="https://kie.apache.org/dmn/_15EDFFFA-F0BA-433C-9CFF-2A86EEA4F439" xmlns:included3="https://kie.apache.org/dmn/_C189BB80-C23E-476E-B0BB-DDF4FF7D305A" id="_5000ABCB-167A-4001-96AD-1EAC1D266FD6" name="SctfAgeRequirement" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_6DD53443-571F-4F35-9881-5F7091F9CE59">
  <dmn:description>Evaluate the implemented Senior Citizen Tax Freeze age pathways at current-year December 31.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="Philadelphia Senior Citizen Tax Freeze — age and income requirements" url="https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/get-real-estate-tax-relief/tax-freeze/low-income-senior-citizen-real-estate-tax-freeze/" />
  </dmn:extensionElements>
  <dmn:import id="_1C14F6F4-3BA7-4818-B667-95B447E799B4" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:import id="_996E205D-A3FF-447D-A436-F0206E6784BE" name="Internal" namespace="https://kie.apache.org/dmn/_15EDFFFA-F0BA-433C-9CFF-2A86EEA4F439" locationURI="Internal.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:import id="_57D0C5AB-AD7B-48FB-A6A2-D1E9701DCE10" name="PersonMinAge" namespace="https://kie.apache.org/dmn/_C189BB80-C23E-476E-B0BB-DDF4FF7D305A" locationURI="../age/person-min-age.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:itemDefinition id="_B32CD958-1AE2-45EB-9A70-F4F30463CB29" name="tSituation" isCollection="false">
    <dmn:description>Minimal local projection for SctfAgeRequirement. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_8B68BCA3-FFD6-42A4-B0F3-FA56F47F3D3C" name="primaryPersonId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DE7D6FFC-AA04-4115-B1F4-60BC628268F1" name="people" isCollection="false">
      <dmn:typeRef>BDT.tPersonList</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_000E1993-4ADF-41B7-B926-082EEF436F83" name="relationships" isCollection="false">
      <dmn:typeRef>BDT.tRelationshipList</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_6C1E2B7A-3D4F-4A8B-9E21-5F7A0C3D8B14" name="simpleChecks" isCollection="false">
      <dmn:typeRef>tSimpleChecks</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_A4D2F1E9-7B3C-4E65-8D10-2C9B6E4F7A31" name="tSimpleChecks" isCollection="false">
    <dmn:description>Minimal local projection for SctfAgeRequirement. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_E8B3C5D1-6F2A-4C97-B04E-1A7D9F2E6C58" name="lateSpouseWasAtLeast65" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decision id="_06629809-CF42-44BB-A240-C72F27A8071A" name="checkResult">
    <dmn:description>True when the applicant is 65+, the first linked spouse is 65+, or the applicant is 50+ and lateSpouseWasAtLeast65 is true. Spouse lookup uses BDT.spouse id; missing relationships leave that route unknown, whereas an empty list establishes no spouse. Unlike RETIP, the implementation does not require spouseLivesInHousehold. No situation.asOfDate override is used. This is age eligibility only; the program also requires income, omitted by the current composing benefit. Source checked 2026-10-17.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="Philadelphia Senior Citizen Tax Freeze — age and income requirements" url="https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/get-real-estate-tax-relief/tax-freeze/low-income-senior-citizen-real-estate-tax-freeze/" />
    </dmn:extensionElements>
    <dmn:variable id="_7795D927-91EA-4006-B324-4A6E87F21A54" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_A15A2DFD-488D-4AFE-A935-0A8142DF7514">
      <dmn:requiredInput href="#_1D0174F9-A149-4A00-A032-76094B64E886" />
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_48662DD9-D639-4D6C-9CDA-668F8DB032B8">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79#_14EAB512-0E33-419C-9630-BA0265476B6E" />
    </dmn:knowledgeRequirement>
    <dmn:knowledgeRequirement id="_90E90B2C-F045-4636-BFBA-582EBF028C9A">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_C189BB80-C23E-476E-B0BB-DDF4FF7D305A#_6E428234-5215-4D38-AB4E-9083E80882D4" />
    </dmn:knowledgeRequirement>
    <dmn:context id="_FF052B53-7815-4E78-AA54-E848A9E22DDC" label="checkResult" typeRef="boolean">
      <dmn:contextEntry id="_C8EC4A92-3434-4561-A643-B587628C6222">
        <dmn:variable id="_7AD6366D-70D0-40CE-8427-6E160FC5DE04" name="SpouseId" typeRef="string">
          <dmn:description></dmn:description>
        </dmn:variable>
        <dmn:literalExpression id="_C22E7B6B-9364-43C4-A3E5-8C53EF8CAAAD" typeRef="string" label="SpouseId">
          <dmn:text>BDT.spouse id(situation.relationships, situation.primaryPersonId)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_C18883FB-FAE8-4295-AB40-07331F92A3EF">
        <dmn:variable id="_2A350996-32D0-4AC5-862E-29B0151014D4" name="PrimaryPerson65PlusThisYear" typeRef="boolean" />
        <dmn:literalExpression id="_3D699621-890F-4FF5-A681-60FE6AD298F2">
          <dmn:text>PersonMinAge.PersonMinAgeService(situation: situation, parameters: { personId: situation.primaryPersonId, minAge: 65, asOfDate: date((for current date in [today()] return current date.year)[1], 12, 31) })</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_720F18F1-D353-4B6B-A9C8-A618B3DBF9EC">
        <dmn:variable id="_3A556851-307A-4D28-A6EC-9725095591A1" name="PrimaryPerson50PlusThisYear" typeRef="boolean" />
        <dmn:literalExpression id="_B669E583-BB97-4CAA-A402-DEF9B366DE5B">
          <dmn:text>PersonMinAge.PersonMinAgeService(situation: situation, parameters: { personId: situation.primaryPersonId, minAge: 50, asOfDate: date((for current date in [today()] return current date.year)[1], 12, 31) })</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_6FE5748D-3916-44A2-8372-035ECFDE37CF">
        <dmn:variable id="_8E99E291-6D59-4FEA-BDB9-CD4183645A13" name="Spouse65PlusThisYear" typeRef="boolean" />
        <dmn:literalExpression id="_04877114-6AC3-4B39-8E5A-CF13EBA2CBE0" label="Spouse65PlusThisYear" typeRef="boolean">
          <dmn:text>PersonMinAge.PersonMinAgeService(situation: situation, parameters: { personId: SpouseId, minAge: 65, asOfDate: date((for current date in [today()] return current date.year)[1], 12, 31) })</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_BEBBEF25-6F3D-4E3D-8278-63DBE450F855">
        <dmn:variable id="_0A921B95-0B16-49B7-BC81-488641C9C798" name="LateSpouseWasAtLeast65" typeRef="boolean" />
        <dmn:literalExpression id="_B3B1DC6C-4E75-463D-97F2-C53D2E2A020F">
          <dmn:text>situation.simpleChecks.lateSpouseWasAtLeast65</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_741AFA00-8331-41A7-863E-1DC3DA6AC10B">
        <dmn:variable id="_04B4CC0C-D9C5-4080-8AFF-50A12285FBEC" name="result" typeRef="boolean" />
        <dmn:literalExpression id="_F13F433B-FE49-475C-981C-D23B1533DBB7">
          <dmn:text>PrimaryPerson65PlusThisYear
or (if situation.relationships = null then null else if SpouseId = null then false else Spouse65PlusThisYear)
or (PrimaryPerson50PlusThisYear and LateSpouseWasAtLeast65)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="_3994E127-ED91-4868-B2F9-6400D0C9657D">
        <dmn:literalExpression id="_39438FCA-9EFB-4208-A145-2FA5128C536A">
          <dmn:text>result</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:inputData id="_1D0174F9-A149-4A00-A032-76094B64E886" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_992C054B-AF0D-4126-B680-78354D9E055B" name="situation" typeRef="tSituation" />
  </dmn:inputData>
