    <dmn:literalExpression id="_A6DD0A3A-3C20-400A-B23D-9F4ED3D43B67">
      <dmn:text>HouseholdPovertyIncome.HouseholdPovertyIncomeService(situation: situation, parameters: {basis: "phl-tap", percent: 150, schedule: "calendar"}) or (if situation.waterHardship.claimed = false then false else if situation.waterHardship.claimed = true then situation.waterHardship.approved else null)</dmn:text>
    </dmn:literalExpression>
