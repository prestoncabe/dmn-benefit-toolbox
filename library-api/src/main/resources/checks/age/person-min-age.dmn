            <kie:width>453</kie:width>
          </kie:ComponentWidths>
          <kie:ComponentWidths dmnElementRef="_7EA7F2D2-C943-48B3-BAFF-F748D93256F3">
            <kie:width>453</kie:width>
          </kie:ComponentWidths>
        </kie:ComponentsWidthsExtension>
      </di:extension>
