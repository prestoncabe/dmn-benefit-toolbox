meta {
  name: Listed status with citizenship unanswered
  type: http
  seq: 22
}

post {
  url: {{host}}/checks/utilities/household-has-liheap-citizenship-status
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "household": {
        "liheapNoncitizenStatuses": [
          "permanent-resident"
        ]
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
