  <dmn:decisionService id="_A7F36AA9-F403-4E02-AC9D-5DBBF329D2AA" name="WapCategoricalEligibilityService">
    <dmn:extensionElements />
    <dmn:variable id="_15B80D82-7AB2-47D1-BE67-3EC76D08E3FB" name="WapCategoricalEligibilityService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_DB46A25C-B873-4C60-AB99-0804F5FED2B0" />
    <dmn:inputData href="#_4AAED49E-F006-4841-A97A-E43CB191C1F0" />
  </dmn:decisionService>
  <dmn:decision id="_DB46A25C-B873-4C60-AB99-0804F5FED2B0" name="checkResult">
    <dmn:description>Recognized exact benefit labels are SSI, TANF, PaLiheap, HUD and USDA; SNAP alone is not sufficient. The enrollment personId must match a people[].id. Require wapEligibilityVerified=true, verifiedOn no later than the comparison date, and wapEligibilityValidThrough no earlier than that date (both endpoints inclusive). Use asOfDate or today(). Provider review must establish qualifying program, documentation, actual receipt/lookback and certification period; generic HUD/USDA participation is insufficient. No common lookback is invented across all routes. A missing list is unknown; an empty list fails. Policy review 2026-10-15.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="Pennsylvania DCED WAP — income and categorical eligibility" url="https://dced.pa.gov/housing-and-development/weatherization/income-eligibility/" />
      <kie:attachment name="10 CFR 440.22 — dwelling, categorical and building eligibility" url="https://www.ecfr.gov/current/title-10/chapter-II/subchapter-D/part-440/section-440.22" />
    </dmn:extensionElements>
    <dmn:variable id="_CFBD6204-ED7C-48CB-B827-1CD895F4B1D3" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_09E164C9-08AB-4FF3-B801-CFDC09E4CB74">
      <dmn:requiredInput href="#_4AAED49E-F006-4841-A97A-E43CB191C1F0" />
    </dmn:informationRequirement>
    <dmn:context id="_1B3D36A3-A16F-49C5-9B0C-012315EE87EA">
      <dmn:contextEntry>
        <dmn:variable id="_AD5C44E8-6A77-4836-A434-B880BBCB0F88" name="comparisonDate" typeRef="date" />
        <dmn:literalExpression id="_5C74F5BC-B81A-43B4-A98C-124E8A16E039">
          <dmn:text>if situation.asOfDate = null then today() else situation.asOfDate</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_D2023B5D-B8F0-4E0D-B098-FACC423B08A4">
          <dmn:text>if situation.enrollments = null then null else any(for enrollment in situation.enrollments return (if enrollment.benefit = null then null else list contains(["SSI", "TANF", "PaLiheap", "HUD", "USDA"], enrollment.benefit)) and enrollment.wapEligibilityVerified and
 (if enrollment.verifiedOn = null or date(enrollment.verifiedOn) &gt; comparisonDate or enrollment.wapEligibilityValidThrough = null then null else date(enrollment.wapEligibilityValidThrough) &gt;= comparisonDate) and
 (if enrollment.personId = null or situation.people = null then null else any(for person in situation.people return if person.id = null then null else person.id = enrollment.personId)))</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:inputData id="_4AAED49E-F006-4841-A97A-E43CB191C1F0" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_1FBAAB70-4C94-4561-9119-4884A67A0D89" name="situation" typeRef="tSituation" />
  </dmn:inputData>
