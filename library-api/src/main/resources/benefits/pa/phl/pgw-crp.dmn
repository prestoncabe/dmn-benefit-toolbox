  <dmn:decision id="_99D7CA87-25A8-47F3-B8AC-48EEFDBCAFE9" name="isEligible">
    <dmn:description>Aggregate named check results with FEEL all: any false yields false; otherwise unresolved checks yield null; all true yields true. This covers only implemented screening conditions, not award approval, funding or deadlines.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_F278BC82-75EA-4817-B55C-6082C999331A" name="isEligible" typeRef="boolean" />
    <dmn:informationRequirement id="_78F936FE-5015-4EC3-BDFB-E7A74C5DF8ED">
      <dmn:requiredDecision href="#_082C4F8B-F38E-4015-AB76-153A11C1BA87" />
    </dmn:informationRequirement>
    <dmn:context id="_097DB491-AC04-45B7-BBDF-AD18B819F620">
      <dmn:contextEntry>
        <dmn:variable id="_1914AD3A-E696-45E7-AB3C-CD470F046BA6" name="checksAsList" typeRef="BDT.tBooleanList" />
        <dmn:literalExpression id="_67027E72-6476-4BE9-9255-8177EA939E7B">
          <dmn:text>for check in get entries(checks) return check.value</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_260FE075-2ABD-4875-BEA9-5BE7B2A58A98">
          <dmn:text>all(checksAsList)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
