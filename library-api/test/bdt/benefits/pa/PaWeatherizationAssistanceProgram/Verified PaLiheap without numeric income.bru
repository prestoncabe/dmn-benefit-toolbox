meta {
  name: Verified PaLiheap without numeric income
  type: http
  seq: 16
}

post {
  url: {{host}}/benefits/pa/weatherization-assistance-program
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPennsylvania": true,
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": [],
      "dwelling": {
        "occupiesHome": true,
        "tenure": "owner",
        "buildingEligibilityVerified": true,
        "previouslyWeatherized": false
      },
      "household": {
        "wapCategoricalEnrollment": {
          "benefit": "PaLiheap",
          "verified": true,
          "verifiedOn": "2026-10-15",
          "validThrough": "2027-10-15"
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq true
}
