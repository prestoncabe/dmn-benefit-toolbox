  <dmn:decision id="_5363237A-5A26-4F10-939B-B24EDD63462C" name="nextSteps">
    <dmn:description>Application instructions and help contacts. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_7D44BAEE-2A27-4A3C-9735-5C0C229DE1AC" name="nextSteps" typeRef="BDT.tNextSteps"/>
    <dmn:literalExpression id="_99328643-9DFE-4B5E-BDD7-BE5CAF399CCF">
      <dmn:text>{
  eligible: {
    applyUrl: "https://tax-services.phila.gov/_/",
    helpUrl: "https://www.phila.gov/services/payments-assistance-taxes/payment-plans-and-assistance-programs/income-based-programs-for-residents/apply-for-the-longtime-owner-occupants-program-loop/",
    helpPhone: "(215) 686-9200",
    body: "Use the Philadelphia Tax Center to find your property, open its OPA number, and choose the real estate assistance application. The program page also has a paper application.\n\n- Include proof of income.\n- Compare LOOP and Homestead savings before switching: you cannot receive both at once. Request Homestead removal with your LOOP application if needed.\n- Applications are accepted throughout the year. Apply by September 30 for the benefit to apply to that year's bill."
  },
  ineligible: {
    note: "Receiving the Homestead Exemption does not stop you from applying for LOOP, but you must request Homestead removal when applying. Use the City's property tax calculator to compare the programs first."
  }
}</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
