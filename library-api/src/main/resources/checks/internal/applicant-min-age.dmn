<?xml version='1.0' encoding='UTF-8'?>
<dmn:definitions xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:kie="https://kie.org/dmn/extensions/1.0" id="_1C6001CD-59E8-4156-A17D-9A0110E54221" name="ApplicantMinAge" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_6D4DBF01-2CD9-4D78-9F2A-3CCD6662DC97" xmlns="https://kie.apache.org/dmn/_6D4DBF01-2CD9-4D78-9F2A-3CCD6662DC97" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/" xmlns:included1="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" xmlns:included2="https://kie.apache.org/dmn/_15EDFFFA-F0BA-433C-9CFF-2A86EEA4F439" xmlns:included3="https://kie.apache.org/dmn/_C189BB80-C23E-476E-B0BB-DDF4FF7D305A">
  <dmn:description>Adapt the shared person-age check to the primary applicant and screening date.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="Philadelphia water rates effective 2026-09-01 — §5.2(b), senior discount" url="https://water.phila.gov/wp-content/uploads/files/rates-and-charges-2026-09-01.pdf" />
  </dmn:extensionElements>
  <dmn:import id="_6E051221-00DE-4A32-B84F-EC5639FAE4F0" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:import id="_C1CEBE93-6955-47E8-BB38-59B52636D464" name="Internal" namespace="https://kie.apache.org/dmn/_15EDFFFA-F0BA-433C-9CFF-2A86EEA4F439" locationURI="Internal.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:import id="_19204ABE-67C4-4C72-96C0-645A98A43C75" name="PersonMinAge" namespace="https://kie.apache.org/dmn/_C189BB80-C23E-476E-B0BB-DDF4FF7D305A" locationURI="../age/person-min-age.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:itemDefinition id="_8150CC7D-D80F-469A-9DC6-38AA75C21229" name="tParameters" isCollection="false">
    <dmn:description>Caller-supplied rule parameters. These configure this reusable comparison; consuming benefits own policy-specific values.</dmn:description>
    <dmn:itemComponent id="_753357BD-A777-4D04-A545-51676F5B56F1" name="minAge" isCollection="false">
      <dmn:description>Inclusive minimum completed age in years, chosen by the consuming program.</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_9C376413-4E4F-483C-BA32-31D454C66A72" name="tSituation" isCollection="false">
    <dmn:description>Minimal local projection for ApplicantMinAge. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_2B91723A-84F4-46C7-8510-3B75927B5129" name="asOfDate" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_88CEDBDE-6D18-4BA4-A911-CE3E539F2C5B" name="primaryPersonId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_B24CCD86-3D77-4D87-B703-6349C13D8992" name="people" isCollection="false">
      <dmn:typeRef>tPeople</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_92D52D6D-8F7A-4EEE-9EF5-A2F7C886C7F8" name="tPeopleItem" isCollection="false">
    <dmn:description>Minimal local projection for ApplicantMinAge. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_90E3CD5F-0215-48ED-8125-711930D222DA" name="id" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_304FCC43-ACAC-4645-A827-D198F8EAA0B1" name="dateOfBirth" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_E4A1A805-6C86-4F8E-ABD1-F1C310BA514A" name="tPeople" isCollection="true">
    <dmn:description>Minimal local projection for ApplicantMinAge. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:typeRef>tPeopleItem</dmn:typeRef>
  </dmn:itemDefinition>
  <dmn:decisionService id="_E40220AA-E4EC-45E4-BA63-31291C6731D7" name="ApplicantMinAgeService">
    <dmn:extensionElements />
    <dmn:variable id="_4783BBC0-1AAA-4185-9917-B168B3792CE2" name="ApplicantMinAgeService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_F07A600D-90CA-4A20-841E-721E70C48735" />
    <dmn:inputData href="#_2F270FEE-22CC-4020-BF5B-9969638E9B57" />
    <dmn:inputData href="#_1A762DA6-DE42-4525-81A6-FCA1C7D45698" />
  </dmn:decisionService>
  <dmn:decision id="_F07A600D-90CA-4A20-841E-721E70C48735" name="checkResult">
    <dmn:description>Invokes PersonMinAge using primaryPersonId, caller minAge and situation.asOfDate, defaulting an omitted date to today(). Missing primaryPersonId returns null; missing birth-date behavior is inherited. Senior water supplies 65. The adapter keeps derived parameter bindings inside the library so benefit composition remains discoverable.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="Philadelphia water rates effective 2026-09-01 — §5.2(b), senior discount" url="https://water.phila.gov/wp-content/uploads/files/rates-and-charges-2026-09-01.pdf" />
    </dmn:extensionElements>
    <dmn:variable id="_73CAC006-17A2-4DF1-AFE0-89A3FC11B94F" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_82A823D1-0AD0-4200-9CAE-E18579FA3A1B">
      <dmn:requiredInput href="#_2F270FEE-22CC-4020-BF5B-9969638E9B57" />
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_F3ED5784-B636-4001-B0A3-9D7D8A24E23F">
      <dmn:requiredInput href="#_1A762DA6-DE42-4525-81A6-FCA1C7D45698" />
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_B113413E-022D-416E-9956-5010B2E6502A">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_C189BB80-C23E-476E-B0BB-DDF4FF7D305A#_6E428234-5215-4D38-AB4E-9083E80882D4" />
    </dmn:knowledgeRequirement>
    <dmn:literalExpression id="_F8C7220D-51D7-4CD3-A306-89FA8317F807">
      <dmn:text>if situation.primaryPersonId = null then null else PersonMinAge.PersonMinAgeService(situation: situation, parameters: {personId: situation.primaryPersonId, minAge: parameters.minAge, asOfDate: if situation.asOfDate = null then today() else situation.asOfDate})</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_2F270FEE-22CC-4020-BF5B-9969638E9B57" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_D4EE02B5-4F7C-4AC4-85B7-6FC5EA8E2829" name="situation" typeRef="tSituation" />
  </dmn:inputData>
  <dmn:inputData id="_1A762DA6-DE42-4525-81A6-FCA1C7D45698" name="parameters">
    <dmn:description>Caller-supplied parameters; see the associated type and rule description for its contract.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_37680FDD-666D-4D64-917B-2A9182DA6779" name="parameters" typeRef="tParameters" />
  </dmn:inputData>
