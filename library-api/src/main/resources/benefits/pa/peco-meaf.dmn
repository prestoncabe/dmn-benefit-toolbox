  <dmn:decision id="_55A1D707-CE4E-4A15-8A30-5CF2B719D5B5" name="checks">
    <dmn:description>Requires prepared peco-meaf income at/below 200% FPL, a qualifying PECO account with an emergency and a verified zero-balance package, and no PaPecoMeaf receipt in the preceding 12 calendar months. Use MEAF-specific income verification and rules, not the separate UESF Utility Grant Program. PECO overview rendered no detailed rule text at review; the administering agency labeled MEAF section supplies those details. No Philadelphia-only restriction, UGP waiting period or additional fuel exclusion is inferred. Household screening only: application windows, available funds, waitlists and provider scheduling do not change checks/isEligible. No award, account establishment or work approval is calculated. Policy review preserved from 2026-10-15. Named entries invoke reusable check Decision Services; inspect those models for their policy interpretation and input contract.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="PECO MEAF — overview; no detailed rule text rendered at review" url="https://www.peco.com/MyAccount/CustomerSupport/Pages/MEAFOV.aspx" />
      <kie:attachment name="UESF — MEAF Assistance Eligibility section (not UGP rules)" url="https://uesfacts.org/our-programs/utility-grant-program/" />
    </dmn:extensionElements>
    <dmn:variable id="_1F03FD86-B585-4AF4-8651-B954E2938A72" name="checks" typeRef="context" />
    <dmn:informationRequirement id="_7D6EED1D-A74F-416D-8474-BD4E5FD63BCD">
      <dmn:requiredInput href="#_F819A105-4694-4DE7-B806-18B1984BEE46" />
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_ED03417B-BCC0-4D7F-AF0C-08D4FD2295C0">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_6CA0D6F6-15DE-4224-82AB-826C63A9F750#_F97BD322-5442-4684-A00F-2210CAC9D016" />
    </dmn:knowledgeRequirement>
