  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPennsylvania": true,
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": [
        {
          "basis": "pa-liheap",
          "annualIncome": 0,
          "householdSize": null
        }
      ],
      "people": [
        {
          "liheapEligibleMember": true
        }
      ],
      "heating": {
        "liheapArrangementVerified": true,
        "primaryCostResponsibility": "direct",
        "secondaryCostResponsibility": "none",
        "rentBasedOnIncome": false
      },
      "assistanceHistory": []
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq null
}
