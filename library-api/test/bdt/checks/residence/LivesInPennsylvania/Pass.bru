meta {
  name: Pass
  type: http
  seq: 1
}

post {
  url: {{host}}/checks/residence/lives-in-pennsylvania
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPennsylvania": true,
        "livesInPhiladelphiaPa": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
