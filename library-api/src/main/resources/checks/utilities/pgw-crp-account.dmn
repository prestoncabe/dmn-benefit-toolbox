<?xml version='1.0' encoding='UTF-8'?>
<dmn:definitions xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:kie="https://kie.org/dmn/extensions/1.0" id="_2AAFF17B-E47C-48A2-AAF9-314C54C7AE07" name="PgwCrpAccount" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_2480740F-FBA3-41AF-9F2B-9AA529AB5B1A" xmlns="https://kie.apache.org/dmn/_2480740F-FBA3-41AF-9F2B-9AA529AB5B1A" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/" xmlns:included1="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" xmlns:included2="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C">
  <dmn:description>Check PGW residential responsibility and applicable prior-participant cure/reconnection payments.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="PGW Customer Responsibility Program" url="https://www.pgworks.com/customer-care/crp" />
    <kie:attachment name="PGW 2026 assistance guidelines" url="https://www.pgworks.com/uploads/pdfs/AssistanceProgramGuidelines2026.pdf" />
    <kie:attachment name="PGW CRP application — income preparation and re-entry" url="https://www.pgworks.com/uploads/pdfs/CRPApplicationEng.pdf" />
  </dmn:extensionElements>
  <dmn:import id="_EC3DA3E0-EDB9-45EB-9780-C7A608ADE00B" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:import id="_80082C33-6797-42DA-AF05-476D6081B992" name="Utilities" namespace="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C" locationURI="Utilities.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:itemDefinition id="_061BB94B-73B5-4DD7-AE76-F1A358021B92" name="tSituation" isCollection="false">
    <dmn:description>Minimal local projection for PgwCrpAccount. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_F715BE6A-4944-40DF-93A6-190D122B283C" name="utilityAccounts" isCollection="false">
      <dmn:typeRef>tUtilityAccounts</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_17ACB884-0716-45BF-972D-5886FBFAF131" name="tUtilityAccount" isCollection="false">
    <dmn:description>Minimal local projection for PgwCrpAccount. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_218CF081-8665-4ABC-843A-D0743ED2F086" name="residential" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_C0AC9AB7-AA37-41D1-9AC4-D78A52F8C440" name="applicantIsCustomer" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_2AD93149-88E3-40F7-BD6B-58665A9C14FC" name="occupiesServiceAddress" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_9FEE4B8F-E969-4B0F-91D7-C1DFD83B9FE8" name="previouslyInCrp" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_95561C7B-6DF1-4457-9C46-315540F5BA9B" name="crpCurePaid" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_328E475E-0273-4799-A176-46237364AADC" name="reconnectionRequired" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_62639510-ED60-463C-9E4A-2FEC90CDA9FF" name="reconnectionFeePaid" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_2DA2752A-4D6B-4B76-AB8E-71A8BE568BDD" name="tUtilityAccounts" isCollection="false">
    <dmn:description>Minimal local projection for PgwCrpAccount. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_6F5C7D58-2816-40D9-9386-EAACBB40D008" name="pgw" isCollection="false">
      <dmn:typeRef>tUtilityAccount</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_FF0C47D3-2B77-4BBA-8535-565EA2D05BAD" name="PgwCrpAccountService">
    <dmn:extensionElements />
    <dmn:variable id="_DE4D0B7B-6121-43B3-B540-9BD276A1181B" name="PgwCrpAccountService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_60486952-851B-4C80-96B9-604E40EF4701" />
    <dmn:inputData href="#_D8FA0D6D-7608-4CDB-A749-3473D6F352CF" />
  </dmn:decisionService>
  <dmn:decision id="_60486952-851B-4C80-96B9-604E40EF4701" name="checkResult">
    <dmn:description>All conditions belong to the same PGW account, utilityAccounts.pgw. previouslyInCrp=false passes the re-entry condition without arrears or payment prerequisites. Prior participants need crpCurePaid; when reconnectionRequired=true they also need reconnectionFeePaid. crpCurePaid records the amount PGW actually requires after any income-based reduction, not a computed historic debt. Missing prior participation, review or applicable fee answers retain unknown results. Policy review 2026-10-15.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="PGW Customer Responsibility Program" url="https://www.pgworks.com/customer-care/crp" />
      <kie:attachment name="PGW 2026 assistance guidelines" url="https://www.pgworks.com/uploads/pdfs/AssistanceProgramGuidelines2026.pdf" />
      <kie:attachment name="PGW CRP application — income preparation and re-entry" url="https://www.pgworks.com/uploads/pdfs/CRPApplicationEng.pdf" />
    </dmn:extensionElements>
    <dmn:variable id="_34E0B752-A29A-4E79-9648-6352463FDD23" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_D526D73A-9774-495E-9D0A-855F01140BBE">
      <dmn:requiredInput href="#_D8FA0D6D-7608-4CDB-A749-3473D6F352CF" />
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_C8F6286E-3BBB-417A-88E6-2A1A1804E18A">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C#_BDB4C5D2-69EA-43C1-BCA3-07F7C2A9132C" />
    </dmn:knowledgeRequirement>
    <dmn:context id="_B06B284B-082D-48F7-AC3A-A4994C4C485D">
      <dmn:contextEntry>
        <dmn:variable id="_59B6D2C9-D269-4DA5-B89F-5ADFE9B7A0D6" name="account" typeRef="tUtilityAccount" />
        <dmn:literalExpression id="_65F174EB-B9E5-4A86-8CA1-3BD81EF12874">
          <dmn:text>if situation.utilityAccounts = null then null else situation.utilityAccounts.pgw</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_95E10C8B-26C1-453E-8103-CDBFAF3912FD">
          <dmn:text>Utilities.residential account(account) and (if account.previouslyInCrp = false then true else if account.previouslyInCrp = true then account.crpCurePaid and (if account.reconnectionRequired = false then true else if account.reconnectionRequired = true then account.reconnectionFeePaid else null) else null)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:inputData id="_D8FA0D6D-7608-4CDB-A749-3473D6F352CF" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_FD47C91F-A802-4381-A298-296B16D599AD" name="situation" typeRef="tSituation" />
  </dmn:inputData>
