        }
      ],
      "assistanceHistory": {
        "paLiheap": {
          "heatingSeason": "2026-27",
          "receivedRegularCash": false
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq null
}
