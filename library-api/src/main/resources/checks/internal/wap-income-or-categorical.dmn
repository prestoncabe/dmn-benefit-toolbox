  </dmn:itemDefinition>
  <dmn:itemDefinition id="_A12D3348-0562-4C9D-93BB-0BEBFB330970" name="tWapCategoricalEnrollment" isCollection="false">
    <dmn:description>Minimal local projection for WapIncomeOrCategorical. Reuse the canonical field meanings in BDT.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_E6CA31A5-9098-4B77-B0B8-27FB97C9C432" name="benefit" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
      <dmn:allowedValues kie:constraintType="enumeration" id="_09FD5956-B2E7-4F3B-AA82-AE39C4D7FE20">
        <dmn:text>&quot;SSI&quot;, &quot;TANF&quot;, &quot;PaLiheap&quot;, &quot;HUD&quot;, &quot;USDA&quot;</dmn:text>
      </dmn:allowedValues>
    </dmn:itemComponent>
    <dmn:itemComponent id="_51FC07D1-2837-4391-A3F9-38EC1293DDE2" name="verified" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_5F652B30-EADF-4B6A-AFA2-F71BF1999191" name="verifiedOn" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_932A6059-D91D-43CE-A3C6-16BA81D9DE1A" name="validThrough" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_508B1E49-D262-4553-92A8-479023260ED5" name="WapIncomeOrCategoricalService">
    <dmn:extensionElements />
    <dmn:variable id="_D6B5E8DD-FC44-4386-86C7-0EFFB13A5BFD" name="WapIncomeOrCategoricalService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_0AEEEC57-0C32-44DB-8100-3612910A8BCC" />
    <dmn:inputData href="#_E5EB57D6-89DE-41B9-951D-102503D43A40" />
  </dmn:decisionService>
  <dmn:decision id="_0AEEEC57-0C32-44DB-8100-3612910A8BCC" name="checkResult">
    <dmn:description>Invokes HouseholdPovertyIncome(pa-wap,200,calendar) or WapCategoricalEligibility using the same household situation. FEEL OR allows verified categorical eligibility to pass without numeric income, and an income pass need not wait for enrollment evidence. Keep the alternatives within this internal check so benefit composition does not require both. Policy review 2026-10-15.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="Pennsylvania DCED WAP — income and categorical eligibility" url="https://dced.pa.gov/housing-and-development/weatherization/income-eligibility/" />
      <kie:attachment name="10 CFR 440.22 — dwelling, categorical and building eligibility" url="https://www.ecfr.gov/current/title-10/chapter-II/subchapter-D/part-440/section-440.22" />
    </dmn:extensionElements>
    <dmn:variable id="_2516D9C1-B84B-43A7-A871-849FC805838F" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_95BFAF13-E983-4E0E-B77F-42B224587360">
      <dmn:requiredInput href="#_E5EB57D6-89DE-41B9-951D-102503D43A40" />
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_3315EAD2-A60D-4875-8F49-C7F32B93283E">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_6CA0D6F6-15DE-4224-82AB-826C63A9F750#_F97BD322-5442-4684-A00F-2210CAC9D016" />
    </dmn:knowledgeRequirement>
    <dmn:knowledgeRequirement id="_944ED7EC-8AE1-4AC8-92EC-9D734E21B927">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_3E2683BC-DE87-4511-A901-9B99CC9BAE76#_A7F36AA9-F403-4E02-AC9D-5DBBF329D2AA" />
    </dmn:knowledgeRequirement>
    <dmn:literalExpression id="_8B48BAEC-4C31-4A1E-A0A4-6A60058DBBFC">
      <dmn:text>HouseholdPovertyIncome.HouseholdPovertyIncomeService(situation: situation, parameters: {basis: "pa-wap", percent: 200, schedule: "calendar"}) or WapCategoricalEligibility.WapCategoricalEligibilityService(situation: situation)</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_E5EB57D6-89DE-41B9-951D-102503D43A40" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_AF248935-067B-4C00-A5F6-F5121B9BBECF" name="situation" typeRef="tSituation" />
  </dmn:inputData>
