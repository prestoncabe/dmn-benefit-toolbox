meta {
  name: Nine person boundary
  type: http
  seq: 12
}

post {
  url: {{host}}/benefits/pa/weatherization-assistance-program
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPennsylvania": true,
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": {
        "paWap": {
          "annualIncome": 122800.0,
          "householdSize": 9
        }
      },
      "dwelling": {
        "occupiesHome": true,
        "tenure": "owner",
        "buildingEligibilityVerified": true,
        "previouslyWeatherized": false
      },
      "household": {
        "wapCategoricalEnrollment": {
          "verified": false
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq true
}
