meta {
  name: Unknown citizen with known empty statuses
  type: http
  seq: 16
}

post {
  url: {{host}}/checks/utilities/household-has-liheap-citizenship-status
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "household": {
        "hasUsCitizen": null,
        "liheapNoncitizenStatuses": []
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq null
}
