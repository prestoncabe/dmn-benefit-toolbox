meta {
  name: Separate bill with other answers missing
  type: http
  seq: 8
}

post {
  url: {{host}}/checks/utilities/liheap-heating-responsibility
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "heating": {
        "responsibleForSeparatePrimaryHeatingCosts": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
