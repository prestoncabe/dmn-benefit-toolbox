          <di:waypoint x="80.0" y="240" />
          <di:waypoint x="360.0" y="240" />
        </dmndi:DMNDecisionServiceDividerLine>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_B56A16FC-E0AB-4866-8EAD-D0C1CD9E7A18" dmnElementRef="_9AED3E9E-A37D-4B6C-BC70-454094766234" isCollapsed="false">
        <dc:Bounds x="140.0" y="130" width="160" height="80" />
        <dmndi:DMNLabel />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_971F4E5B-A053-4A72-B8A5-FF7E2C6ED829" dmnElementRef="_0811ABCD-B15F-42A1-80D2-8D529DCA5830" isCollapsed="false">
        <dc:Bounds x="140.0" y="480" width="160" height="80" />
        <dmndi:DMNLabel />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="_98AEBF67-4441-4D83-8CD0-BF17F08321F5" dmnElementRef="_3EA712E1-A2E3-49CC-8805-F8E19ABF821A" sourceElement="_971F4E5B-A053-4A72-B8A5-FF7E2C6ED829" targetElement="_B56A16FC-E0AB-4866-8EAD-D0C1CD9E7A18">
        <di:waypoint x="220.0" y="480" />
        <di:waypoint x="220.0" y="210" />
