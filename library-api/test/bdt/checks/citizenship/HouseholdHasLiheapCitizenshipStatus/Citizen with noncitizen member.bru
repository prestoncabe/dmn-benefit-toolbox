meta {
  name: Citizen with noncitizen member
  type: http
  seq: 23
}

post {
  url: {{host}}/checks/citizenship/household-has-liheap-citizenship-status
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "people": [
        {
          "citizenshipStatus": "none-of-these"
        },
        {
          "citizenshipStatus": "us-citizen"
        }
      ]
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
