  <dmn:decision id="_AAC4AB86-1D79-4024-B0F9-0667EBE8CCC3" name="isEligible">
    <dmn:description>Aggregate named check results with FEEL all: any false yields false; otherwise unresolved checks yield null; all true yields true. This covers only implemented screening conditions, not award approval, funding or deadlines.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_71938B6B-6638-4B2D-B9C7-7CDF73020EB8" name="isEligible" typeRef="boolean" />
    <dmn:informationRequirement id="_F87D27B0-8D8F-4129-8899-878D562B1DBE">
      <dmn:requiredDecision href="#_91212041-F13C-4C12-B37C-F34D47AB3994" />
    </dmn:informationRequirement>
    <dmn:context id="_46557C3E-630B-4D4C-B7B3-610FE328F069">
      <dmn:contextEntry>
        <dmn:variable id="_7FE8A209-E14E-4D26-A22F-934E49DD02E4" name="checksAsList" typeRef="BDT.tBooleanList" />
        <dmn:literalExpression id="_EAEB1B64-0C2D-4F03-A5FF-54C6488C5E15">
          <dmn:text>for check in get entries(checks) return check.value</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_50665B46-0779-4121-8523-E711E55F88E8">
          <dmn:text>all(checksAsList)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
