      <dmn:typeRef>tIncomeAssessments</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_34F5B879-94D3-4DA9-A6D9-A7F3DA0E6BC7" name="household" isCollection="false">
      <dmn:typeRef>tHousehold</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_0A59FD40-7DFC-4A30-9A71-1943EFD5C615" name="tIncomeAssessmentsItem" isCollection="false">
    <dmn:description>Minimal local projection for WapIncomeOrCategorical. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_76B4F601-B5EA-4BE0-8D60-B20624AE54D9" name="basis" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_600B0BCB-E81F-4860-8389-2C06C5F1D900" name="annualIncome" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_9A4B1D56-D136-4110-8735-7233877F1530" name="householdSize" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_63B957CA-272D-4B76-B3DF-2023006CEAD2" name="tIncomeAssessments" isCollection="true">
    <dmn:description>Minimal local projection for WapIncomeOrCategorical. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
