  <dmn:decisionService id="_BA58546D-4E8A-4FCE-8A39-42A1F5A69762" name="RetipAgeOrIncomeRequirementService">
    <dmn:extensionElements />
    <dmn:variable id="_8FA7B6A2-1E01-42E3-B1D1-EF9C59DCA12A" name="RetipAgeOrIncomeRequirementService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_174BF905-2497-4A91-9B26-359677BECF14" />
    <dmn:inputData href="#_0F3A7B00-32F3-4596-9AF8-3A2129B7E514" />
  </dmn:decisionService>
  <dmn:decision id="_174BF905-2497-4A91-9B26-359677BECF14" name="checkResult">
    <dmn:description>Invokes ApplicantOrSpouseMinAge(minAge:65) or RetipIncome. FEEL OR preserves true from either route even if the other is unknown. No numeric income is required when the age route passes. There is no late-spouse route, and age uses today(), not year-end. Kept internal so the builder does not turn alternatives into separately required checks. Source checked 2026-10-17.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="Philadelphia Real Estate Tax Installment Plan — senior and income routes" url="https://www.phila.gov/services/payments-assistance-taxes/payment-plans-and-assistance-programs/income-based-programs-for-residents/set-up-real-estate-tax-installment-plan/" />
    </dmn:extensionElements>
    <dmn:variable id="_9BD13164-7193-4B52-952B-39DF262BF71E" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_98A808D7-0074-4031-B5B7-1B7B304EFFC4">
      <dmn:requiredInput href="#_0F3A7B00-32F3-4596-9AF8-3A2129B7E514" />
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_1A12578D-176B-4729-962F-0BE20B62A8C7">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_32004365-F30E-4E68-B7EF-6E87FC2EA724#_6A22FC6F-9E65-48FF-A538-7A886D125EDA" />
    </dmn:knowledgeRequirement>
    <dmn:knowledgeRequirement id="_6969E091-4650-407D-B77B-965781782E13">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_0F40186A-672E-4BF8-8481-957F70A70DF4#_30D72817-12C9-4432-A513-97E56AF4F837" />
    </dmn:knowledgeRequirement>
    <dmn:literalExpression id="_C0020626-4DD0-47C3-A4B3-736935708EF7">
      <dmn:text>ApplicantOrSpouseMinAge.ApplicantOrSpouseMinAgeService(situation: situation, parameters: {minAge: 65}) or RetipIncome.RetipIncomeService(situation: situation)</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
