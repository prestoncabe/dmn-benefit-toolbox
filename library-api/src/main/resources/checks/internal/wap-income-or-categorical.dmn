  <dmn:import id="_B18BF015-FF75-4D53-B736-F41A59D5B450" name="WapCategoricalEligibility" namespace="https://kie.apache.org/dmn/_3E2683BC-DE87-4511-A901-9B99CC9BAE76" locationURI="../enrollment/wap-categorical-eligibility.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:itemDefinition id="_D1379A78-2888-4625-8C18-BED4B9ADDFBD" name="tSituation" isCollection="false">
    <dmn:description>Minimal local projection for WapIncomeOrCategorical. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_42130888-89F7-4FC7-BFB2-7394C66D9358" name="asOfDate" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
