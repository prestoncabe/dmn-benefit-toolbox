  <dmn:description>Shared category for U.S. citizenship and immigration-status checks. Reusable checks consume self-reported or recorded status facts; they do not verify documents. Each program supplies its own list of qualifying statuses and any program-specific conditions.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="OMG DMN 1.6 — FEEL and model semantics" url="https://www.omg.org/spec/DMN/1.6/" />
  </dmn:extensionElements>
  <dmn:textAnnotation id="_00D3B28D-425A-4541-B2EF-97D58707F3CE" textFormat="text/plain">
    <dmn:text>BKMs, data types, and/or Decision Services that will be included in every eligibility check categorized as "Citizenship"</dmn:text>
  </dmn:textAnnotation>
