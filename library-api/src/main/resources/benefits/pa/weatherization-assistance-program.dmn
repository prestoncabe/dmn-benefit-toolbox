  <dmn:decision id="_F1220BF7-6D0A-4F82-991B-FD5B6AFE5046" name="isEligible">
    <dmn:description>Aggregate named check results with FEEL all: any false yields false; otherwise unresolved checks yield null; all true yields true. This covers only implemented screening conditions, not award approval, funding or deadlines.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_B9202592-4B19-44CE-8FE2-0427565415D7" name="isEligible" typeRef="boolean" />
    <dmn:informationRequirement id="_43DCC602-206E-43E4-A638-8E3B54D0EBC5">
      <dmn:requiredDecision href="#_9608FF2F-36A9-4676-9106-90CBE1BDEAB4" />
    </dmn:informationRequirement>
    <dmn:context id="_ECA24BC5-1929-429F-BD65-BCF1A7859E6B">
      <dmn:contextEntry>
        <dmn:variable id="_95B0269D-87AD-462D-9EEC-5428837176EB" name="checksAsList" typeRef="BDT.tBooleanList" />
        <dmn:literalExpression id="_298457BB-8E5D-4E29-AADC-C988AAE3166A">
          <dmn:text>for check in get entries(checks) return check.value</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_7C29AF81-6C24-40E7-96C5-B22A73C5D43C">
          <dmn:text>all(checksAsList)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
