      <dmn:typeRef>tPeople</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_F01EFF42-BA35-41AD-AE7F-BE4ED545F70E" name="tPeopleItem" isCollection="false">
    <dmn:description>Minimal local projection for HouseholdHasLiheapEligibleMember. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_256DB4CA-3A86-40FA-85A7-F605985C6729" name="liheapEligibleMember" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_3E53EACD-D093-46D3-856E-87ABA042F24F" name="tPeople" isCollection="true">
    <dmn:description>Minimal local projection for HouseholdHasLiheapEligibleMember. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:typeRef>tPeopleItem</dmn:typeRef>
  </dmn:itemDefinition>
  <dmn:decisionService id="_EB19C977-4DFA-49ED-BB2B-248B7664ECA9" name="HouseholdHasLiheapEligibleMemberService">
    <dmn:extensionElements />
    <dmn:variable id="_A7265CB8-60D4-4ACB-A918-F421C197E184" name="HouseholdHasLiheapEligibleMemberService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_8155B1F4-85C3-4866-8470-F926633FE997" />
    <dmn:inputData href="#_0CB6E6E3-F3B7-4A10-9CEF-0DA4EAE4A003" />
  </dmn:decisionService>
  <dmn:decision id="_8155B1F4-85C3-4866-8470-F926633FE997" name="checkResult">
    <dmn:description>FEEL any over people[].liheapEligibleMember: a verified true establishes the route, an empty list returns false, missing people or unresolved members may yield null. The field records provider/intake classification under FY2027 Appendix B §§601.31 and 601.41, including citizenship/eligible-noncitizen rules and member exclusions. Mixed-status households are not rejected wholesale. Prepared income and eligible-member size must follow the plan distinct treatment, including countable income of ineligible members. Policy review 2026-10-15.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="FY2027 LIHEAP final state plan — Appendix B, §§601.31, 601.41, 601.81–84" url="https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf" />
    </dmn:extensionElements>
    <dmn:variable id="_66C2EA45-013B-4699-A7CE-A1211E472615" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_492813B3-2D9B-4FD1-93B3-4C31A533914E">
      <dmn:requiredInput href="#_0CB6E6E3-F3B7-4A10-9CEF-0DA4EAE4A003" />
    </dmn:informationRequirement>
    <dmn:literalExpression id="_5FCE08D6-139A-4FAB-A34E-289FF43521FC">
      <dmn:text>if situation.people = null then null else any(for person in situation.people return person.liheapEligibleMember)</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_0CB6E6E3-F3B7-4A10-9CEF-0DA4EAE4A003" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_7F2FAAC4-8058-4652-9B28-8C921013F975" name="situation" typeRef="tSituation" />
  </dmn:inputData>
