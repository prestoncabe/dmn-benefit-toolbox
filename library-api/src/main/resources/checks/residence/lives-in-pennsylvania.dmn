      <dmn:requiredInput href="#_4AD3CD19-396D-4035-8383-45ADEAC24203" />
    </dmn:informationRequirement>
    <dmn:literalExpression id="_2FB0E88E-C6F8-4E27-8CAA-21036402EDCC">
      <dmn:text>if situation.simpleChecks.livesInPennsylvania != null then situation.simpleChecks.livesInPennsylvania else if situation.simpleChecks.livesInPhiladelphiaPa = true then true else null</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
