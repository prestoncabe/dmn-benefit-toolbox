          <kie:ComponentWidths dmnElementRef="_C10E19F7-1AE3-4805-9415-9461EC2F3F44">
            <kie:width>917</kie:width>
          </kie:ComponentWidths>
          <kie:ComponentWidths dmnElementRef="_F6C2C6F8-34F6-4A79-B9D8-AED300F04ECB">
            <kie:width>917</kie:width>
