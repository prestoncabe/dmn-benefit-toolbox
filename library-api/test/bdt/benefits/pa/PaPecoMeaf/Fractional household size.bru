}

body:json {
  {
    "situation": {
      "asOfDate": "2026-10-15",
      "incomeAssessments": {
        "pecoMeaf": {
          "annualIncome": 0,
          "householdSize": 1.5
        }
      },
      "utilityAccounts": {
        "peco": {
          "residential": true,
          "applicantIsCustomer": true,
          "occupiesServiceAddress": true,
          "serviceTerminated": false,
          "imminentTermination": true,
          "balanceResolutionVerified": true
        }
      },
      "assistanceHistory": {
        "paPecoMeaf": {
          "received": false
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq null
}
