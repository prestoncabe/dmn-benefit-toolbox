          "residential": true,
          "applicantIsCustomer": true,
          "occupiesServiceAddress": true,
          "serviceTerminated": false,
          "imminentTermination": false,
          "balanceResolutionVerified": true
        }
      },
      "assistanceHistory": {
        "paPecoMeaf": {
          "received": false
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq false
}
