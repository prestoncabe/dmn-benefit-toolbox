      <di:extension>
        <kie:ComponentsWidthsExtension>
          <kie:ComponentWidths dmnElementRef="_63FA2E37-C15A-437E-968C-307A12E8890C">
            <kie:width>50</kie:width>
            <kie:width>376</kie:width>
            <kie:width>599</kie:width>
          </kie:ComponentWidths>
          <kie:ComponentWidths dmnElementRef="_7034A680-8D8F-49A3-82C8-5BFC50D67AE0">
            <kie:width>917</kie:width>
          </kie:ComponentWidths>
