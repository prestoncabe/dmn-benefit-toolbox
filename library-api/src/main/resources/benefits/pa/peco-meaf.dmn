  <dmn:decision id="_DDE4F047-0EDB-411A-AF11-4FB24EEA55A3" name="isEligible">
    <dmn:description>Aggregate named check results with FEEL all: any false yields false; otherwise unresolved checks yield null; all true yields true. This covers only implemented screening conditions, not award approval, funding or deadlines.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_7890CBA7-E225-4BF6-BFE7-56B62B399E4A" name="isEligible" typeRef="boolean" />
    <dmn:informationRequirement id="_A60C79E7-6C77-472A-AFBC-F65AE854969D">
      <dmn:requiredDecision href="#_55A1D707-CE4E-4A15-8A30-5CF2B719D5B5" />
    </dmn:informationRequirement>
    <dmn:context id="_22067454-FECD-4E52-918F-4169863CE524">
      <dmn:contextEntry>
        <dmn:variable id="_9DB60104-60DF-4FCC-A2B6-24059E6E97A9" name="checksAsList" typeRef="BDT.tBooleanList" />
        <dmn:literalExpression id="_600F7348-7182-48EC-9902-4A9E2BA91D0F">
          <dmn:text>for check in get entries(checks) return check.value</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_6017DB51-17EA-477A-BC34-07FBFFB09AFC">
          <dmn:text>all(checksAsList)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
