  <dmn:decision id="_A8B84BCF-FC26-4E20-B5EA-3E2C1D142DF6" name="isEligible">
    <dmn:description>Aggregate named check results with FEEL all: any false yields false; otherwise unresolved checks yield null; all true yields true. This covers only implemented screening conditions, not award approval, funding or deadlines.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_BB98058F-C644-4D6C-9DAB-89302AF9C26A" name="isEligible" typeRef="boolean" />
    <dmn:informationRequirement id="_819A5DE4-1A2E-443A-88B5-F87764C2EC4D">
      <dmn:requiredDecision href="#_4657176A-9315-44F1-A8D5-73A9BDCB9698" />
    </dmn:informationRequirement>
    <dmn:context id="_D0F84406-6C24-462A-AEBB-B847E9D26BB8">
      <dmn:contextEntry>
        <dmn:variable id="_04338A5A-44F0-4F14-B33B-C0988584C21D" name="checksAsList" typeRef="BDT.tBooleanList" />
        <dmn:literalExpression id="_5880E927-6763-43CB-8DC7-8C301828719E">
          <dmn:text>for check in get entries(checks) return check.value</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_81D4480E-EC0D-45DC-B7D4-3628AFBF1C8E">
          <dmn:text>all(checksAsList)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
