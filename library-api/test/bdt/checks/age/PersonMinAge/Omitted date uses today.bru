meta {
  name: Omitted date uses today
  type: http
  seq: 4
}

post {
  url: {{host}}/checks/age/person-min-age
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1950-01-01"
        }
      ]
    },
    "parameters": {
      "personId": "p1",
      "minAge": 65
    }
  }
}

assert {
  res.body.checkResult: eq true
}

settings {
  encodeUrl: true
  timeout: 0
}
