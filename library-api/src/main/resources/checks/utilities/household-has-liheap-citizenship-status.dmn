        <dc:Bounds x="272.0" y="480" width="160" height="80" />
        <dmndi:DMNLabel />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="_1CE6F286-09F1-4DAF-802D-2DE4D976795A" dmnElementRef="_66714105-CADF-4E3C-B03D-B849B7A2F80D" sourceElement="_3D0D5954-09B7-4854-9571-0C5F1676564A" targetElement="_2C67B91D-484C-407A-834F-E37A3FF11206">
        <di:waypoint x="352.0" y="480" />
