  <dmn:description>Check PECO residential responsibility, electric-supply compatibility and provider-approved CAP re-entry.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="PECO customer handbook — CAP, pp. 12–13 and 30" url="https://www.peco.com/SiteCollectionDocuments/PECO_Customer_Handbook_online.pdf" />
    <kie:attachment name="PA PUC order P-2024-3046008, 2024-11-07 — §H, CAP electric supply" url="https://peco-solarrfp.com/assets/files/PA%20PUC%20Order%20%28Docket%20No.%20P-2024-3046008%29_November%207%202024.pdf" />
  </dmn:extensionElements>
  <dmn:import id="_1C65E0F4-0813-4511-A724-7501A32B58CA" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:import id="_34B946C3-0294-416E-8283-6DAF3AC8C9FD" name="Utilities" namespace="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C" locationURI="Utilities.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:itemDefinition id="_553349D8-491C-4FE1-9BDE-5BFEEB6B2886" name="tSituation" isCollection="false">
    <dmn:description>Minimal local projection for PecoCapAccount. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_25EDD59B-A6A8-41EE-B794-73093EAC7227" name="primaryPersonId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_0061BE24-4BB0-401F-A53E-49A670236704" name="utilityAccounts" isCollection="false">
      <dmn:typeRef>tUtilityAccounts</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_821435B0-E638-4D42-8115-FFC0099D6345" name="tUtilityAccountsItem" isCollection="false">
    <dmn:description>Minimal local projection for PecoCapAccount. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_1FFFC152-D30F-42F2-8084-17D76A4A6D72" name="provider" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_CB088E4B-14F0-4B1E-81CE-5F86696BC904" name="residential" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_FB2A9F25-59D5-496D-817F-CD171C4B7970" name="customerPersonId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_BFCFD7A0-4ECE-4EA9-A0C8-0A0D09779B7F" name="occupiesServiceAddress" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_AF4B2C42-5D72-43A3-8717-8AB92338317B" name="defaultService" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_02A03DE0-F9CE-48A6-A642-2C07023DAFD5" name="acceptsDefaultService" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_159C83B4-CB16-474C-BAE3-4AF686D2B56E" name="previouslyInCap" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_3E4ED9CC-4C6D-4DC1-B333-8A30599CFECD" name="capReentryApproved" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_B587E730-940C-423C-B4CE-F5972AB30DB0" name="hasElectricService" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_4EFB8B4F-7CB4-40F1-8C58-9AE4756AB72F" name="tUtilityAccounts" isCollection="true">
    <dmn:description>Minimal local projection for PecoCapAccount. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:typeRef>tUtilityAccountsItem</dmn:typeRef>
  </dmn:itemDefinition>
  <dmn:decisionService id="_AFADA8A8-4A6F-408C-9D03-F7ACC2290596" name="PecoCapAccountService">
    <dmn:extensionElements />
    <dmn:variable id="_464796CC-31AA-44EB-B78F-2D9384C7B4D5" name="PecoCapAccountService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_4DEB1C2A-D569-4728-9FE8-B91180155689" />
    <dmn:inputData href="#_5FA538C1-8DD1-4C88-BFF1-3DE2EBBB2358" />
  </dmn:decisionService>
  <dmn:decision id="_4DEB1C2A-D569-4728-9FE8-B91180155689" name="checkResult">
    <dmn:description>All conditions must hold on the same PECO account. Gas-only service (hasElectricService=false) needs no electric default-supply answer. Otherwise defaultService OR acceptsDefaultService permits compatible supply or consent to transition under the 2024-11-07 PUC order §H; shopping alone does not reject someone willing to switch. Unknown service type can pass with known compatible supply/consent, otherwise remains unresolved. First enrollment requires previouslyInCap=false; prior participants require capReentryApproved. The complete current re-entry policy could not be retrieved, so no cure amount is invented; unresolved provider review stays null. The PUC index linked an old 2016–18 plan, which was not treated as current policy. No arrears prerequisite. Policy review 2026-10-15.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="PECO customer handbook — CAP, pp. 12–13 and 30" url="https://www.peco.com/SiteCollectionDocuments/PECO_Customer_Handbook_online.pdf" />
      <kie:attachment name="PA PUC order P-2024-3046008, 2024-11-07 — §H, CAP electric supply" url="https://peco-solarrfp.com/assets/files/PA%20PUC%20Order%20%28Docket%20No.%20P-2024-3046008%29_November%207%202024.pdf" />
    </dmn:extensionElements>
    <dmn:variable id="_0D52C58A-2392-4157-A565-2405EB70BFB5" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_B9BEFCBA-B19A-489E-BAFC-11A9D5610D6F">
      <dmn:requiredInput href="#_5FA538C1-8DD1-4C88-BFF1-3DE2EBBB2358" />
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_4831A212-4345-4641-81FB-94F0E7E3B88D">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C#_BDB4C5D2-69EA-43C1-BCA3-07F7C2A9132C" />
    </dmn:knowledgeRequirement>
    <dmn:literalExpression id="_96D58097-7CB3-4C02-A7AF-43543DCAFD47">
      <dmn:text>if situation.utilityAccounts = null then null else any(for account in situation.utilityAccounts return Utilities.residential account(account, "PECO", situation.primaryPersonId) and ((if account.hasElectricService = false then true else if account.hasElectricService = true then account.defaultService or account.acceptsDefaultService else if (account.defaultService or account.acceptsDefaultService) = true then true else null) and (if account.previouslyInCap = false then true else if account.previouslyInCap = true then account.capReentryApproved else null)))</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_5FA538C1-8DD1-4C88-BFF1-3DE2EBBB2358" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_A3C69633-B7D7-461C-B0FC-22F2AAADE49D" name="situation" typeRef="tSituation" />
  </dmn:inputData>
  <dmn:textAnnotation id="_C48AFF34-A5D7-45F6-80C8-311BA7D6D25E" textFormat="text/plain">
    <dmn:text>Prior CAP participation requires PECO’s re-entry determination. Unknown approval stays unknown; no cure amount is invented from incomplete public policy.</dmn:text>
  </dmn:textAnnotation>
