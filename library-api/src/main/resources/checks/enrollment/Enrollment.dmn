<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns="https://kie.apache.org/dmn/_6E9D53A6-E99A-4060-9E3E-1AE12EAB5465" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/" xmlns:kie="https://kie.org/dmn/extensions/1.0" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="_CCB44031-5ABF-4677-97E8-924CF1150236" name="Enrollment" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_6E9D53A6-E99A-4060-9E3E-1AE12EAB5465">
  <dmn:description>Shared person/program enrollment records. Enrollment is membership evidence, distinct from dated grant receipts in BDT.assistanceHistory and from provider-verified WAP categorical evidence in BDT.household. Omission means unknown; an empty list means no known enrollment records.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="OMG DMN 1.6 — FEEL and model semantics" url="https://www.omg.org/spec/DMN/1.6/" />
  </dmn:extensionElements>
  <dmn:itemDefinition id="_853E7CDE-4938-4FF2-88BD-9CA645F9A792" name="tEnrollment" isCollection="false">
    <dmn:description>Person/program membership matched by personId and benefit.</dmn:description>
    <dmn:itemComponent id="_76F6D3C7-878D-4E4E-B571-D3FA033C9CAE" name="personId" isCollection="false">
      <dmn:description>Person identifier. Enrollment matches this to the queried person; relationships use it as the outgoing/source person.</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_91AA206A-90FC-4464-8299-90AABCD8E3D2" name="benefit" isCollection="false">
      <dmn:description>Exact case-sensitive library benefit/program identifier, such as PhlLoop or SSI. Membership does not establish grant receipt date.</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_F27E2E28-2B1D-4399-A66B-88AD5F9F3D0C" name="tEnrollmentList" isCollection="true">
    <dmn:description>Collection of tEnrollment. A missing list is unknown; a known empty list contains no records.</dmn:description>
    <dmn:typeRef>tEnrollment</dmn:typeRef>
  </dmn:itemDefinition>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_4DB609BE-1BEA-4836-AEF5-1FC86E4CA585" name="DRG">
      <di:extension>
        <kie:ComponentsWidthsExtension/>
      </di:extension>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</dmn:definitions>