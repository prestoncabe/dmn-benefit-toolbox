meta {
  name: Shared heating cost with income based rent
  type: http
  seq: 9
}

post {
  url: {{host}}/checks/utilities/liheap-heating-responsibility
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "heating": {
        "responsibleForSeparatePrimaryHeatingCosts": true,
        "heatIncludedInRent": true,
        "rentBasedOnIncome": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
