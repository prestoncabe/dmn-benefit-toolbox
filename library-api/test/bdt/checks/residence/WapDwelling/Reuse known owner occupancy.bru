meta {
  name: Reuse known owner occupancy
  type: http
  seq: 16
}

post {
  url: {{host}}/checks/residence/wap-dwelling
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "asOfDate": "2026-10-15",
      "dwelling": {
        "buildingEligibilityVerified": true,
        "previouslyWeatherized": false
      },
      "simpleChecks": {
        "ownerOccupant": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
