meta {
  name: Operating electricity alone does not qualify for Cash
  type: http
  seq: 14
}

post {
  url: {{host}}/checks/utilities/liheap-heating-responsibility
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "heating": {
        "responsibleForSeparatePrimaryHeatingCosts": false,
        "heatIncludedInRent": false,
        "responsibleForHeatingSystemElectricity": true
      }
    },
    "parameters": {
      "crisis": false
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq false
}
