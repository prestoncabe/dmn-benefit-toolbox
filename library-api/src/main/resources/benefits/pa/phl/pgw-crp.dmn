  <dmn:decision id="_082C4F8B-F38E-4015-AB76-153A11C1BA87" name="checks">
    <dmn:description>Requires Philadelphia residence, prepared pgw-crp income at/below 150% FPL, and PGW residential customer responsibility with re-entry review where applicable. Prepare gross annual household income from the preceding 30 days or 12 months, whichever best represents annual income under the application guidance. Owners and renters can qualify. First enrollment does not require arrears. Household screening only: application windows, available funds, waitlists and provider scheduling do not change checks/isEligible. No award, account establishment or work approval is calculated. Policy review preserved from 2026-10-15. Named entries invoke reusable check Decision Services; inspect those models for their policy interpretation and input contract.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="PGW Customer Responsibility Program" url="https://www.pgworks.com/customer-care/crp" />
      <kie:attachment name="PGW 2026 assistance guidelines" url="https://www.pgworks.com/uploads/pdfs/AssistanceProgramGuidelines2026.pdf" />
      <kie:attachment name="PGW CRP application — income preparation and re-entry" url="https://www.pgworks.com/uploads/pdfs/CRPApplicationEng.pdf" />
    </dmn:extensionElements>
    <dmn:variable id="_B558F38E-555A-489D-8092-4B8EF55D5559" name="checks" typeRef="context" />
    <dmn:informationRequirement id="_7FCC6105-D0FC-478F-850B-26ACF9F3B44E">
