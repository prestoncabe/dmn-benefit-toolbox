meta {
  name: One cent above limit
  type: http
  seq: 5
}

post {
  url: {{host}}/benefits/pa/liheap
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPennsylvania": true,
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": {
        "paLiheap": {
          "annualIncome": 23940.01,
          "householdSize": 1
        }
      },
      "heating": {
        "liheapArrangementVerified": true,
        "primaryCostResponsibility": "direct",
        "secondaryCostResponsibility": "none",
        "rentBasedOnIncome": false
      },
      "household": {
        "hasLiheapEligibleMember": true
      },
      "assistanceHistory": {
        "paLiheap": {
          "received": false
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq false
}
