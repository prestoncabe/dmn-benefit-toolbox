meta {
  name: Evidence valid through screening day
  type: http
  seq: 14
}

post {
  url: {{host}}/checks/internal/wap-income-or-categorical
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "incomeAssessments": {},
      "household": {
        "wapCategoricalEnrollment": {
          "benefit": "SSI",
          "verified": true,
          "verifiedOn": "2026-10-15",
          "validThrough": "2026-10-15"
        }
      }
    },
    "parameters": {
      "asOfDate": "2026-10-15"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
