<?xml version='1.0' encoding='UTF-8'?>
<dmn:definitions xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:kie="https://kie.org/dmn/extensions/1.0" id="_9293A0F8-40B0-4C56-8514-0A814D49BCAE" name="Utilities" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C" xmlns="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/">
  <dmn:description>Shared residential utility-account matching, independent of provider-specific program conditions. An account represents established responsibility or a provider-accepted request to establish or restore service at the occupied home. Applicant responsibility, residential status and occupancy must hold on the same provider's account. Do not combine favorable facts from unrelated accounts. Missing facts participate in FEEL three-valued logic.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="Philadelphia water regulations, 2024-04-29 — §§206.1–2" url="https://water.phila.gov/pool/files/pwd-regulations-2024-04-29.pdf" />
    <kie:attachment name="PECO customer handbook — CAP, pp. 12–13 and 30" url="https://www.peco.com/SiteCollectionDocuments/PECO_Customer_Handbook_online.pdf" />
    <kie:attachment name="PGW Customer Responsibility Program" url="https://www.pgworks.com/customer-care/crp" />
  </dmn:extensionElements>
  <dmn:itemDefinition id="_88E1D720-A429-4AA4-970B-E2701DE1548C" name="tAccount" isCollection="false">
    <dmn:description>Minimal shared account facts needed for residential responsibility matching; program-specific supply/emergency/re-entry facts remain on BDT utility records.</dmn:description>
    <dmn:itemComponent id="_C69242B0-FDD0-4E6F-974D-83D8B1613295" name="residential" isCollection="false">
      <dmn:description>Whether this account is residential service, as established by provider/intake review.</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_8E11D69E-F10C-45E4-B138-D9BF7648A8E5" name="applicantIsCustomer" isCollection="false">
      <dmn:description>Whether the applicant is the responsible account customer, or the provider accepted the applicant's request to establish or restore service in their name.</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_488F7841-F4CC-4535-B255-D918CBE845B8" name="occupiesServiceAddress" isCollection="false">
      <dmn:description>Whether the applicant occupies the account service address as their home.</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:businessKnowledgeModel id="_BDB4C5D2-69EA-43C1-BCA3-07F7C2A9132C" name="residential account">
    <dmn:description>Tests one provider's account for applicant responsibility, residential service and occupancy. A missing account is unknown; missing facts yield unknown within FEEL conjunction and known failures can still decide false. No conditions are borrowed from another account.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_82747DF6-50F9-4525-B292-2F73D865A2B2" name="residential account" typeRef="boolean" />
    <dmn:encapsulatedLogic id="_01851AD8-3F77-47A5-BA32-68FB2AE9D75A" kind="FEEL">
      <dmn:formalParameter id="_3CC88292-B52B-4F59-AC26-F030CA7D3B74" name="account" typeRef="tAccount" />
      <dmn:literalExpression id="_AA30809C-731E-4E54-9EB8-C96872562F47">
        <dmn:text>if account = null then null else account.residential and account.occupiesServiceAddress and account.applicantIsCustomer</dmn:text>
      </dmn:literalExpression>
    </dmn:encapsulatedLogic>
  </dmn:businessKnowledgeModel>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_1D52A849-E7C8-426E-B11C-5B4F75740A86" name="DRG">
      <di:extension>
        <kie:ComponentsWidthsExtension>
          <kie:ComponentWidths dmnElementRef="_01851AD8-3F77-47A5-BA32-68FB2AE9D75A">
            <kie:width>50</kie:width>
            <kie:width>917</kie:width>
          </kie:ComponentWidths>
          <kie:ComponentWidths dmnElementRef="_AA30809C-731E-4E54-9EB8-C96872562F47">
            <kie:width>917</kie:width>
          </kie:ComponentWidths>
        </kie:ComponentsWidthsExtension>
      </di:extension>
      <dmndi:DMNShape id="_86F4D5F5-F41E-4783-A6C7-2A75C24AE464" dmnElementRef="_BDB4C5D2-69EA-43C1-BCA3-07F7C2A9132C" isCollapsed="false">
        <dc:Bounds x="80" y="40" width="160" height="80" />
        <dmndi:DMNLabel />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</dmn:definitions>
