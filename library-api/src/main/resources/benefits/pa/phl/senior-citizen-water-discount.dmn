  <dmn:decision id="_56B4C53C-F029-493F-B625-133873B183F6" name="isEligible">
    <dmn:description>Aggregate named check results with FEEL all: any false yields false; otherwise unresolved checks yield null; all true yields true. This covers only implemented screening conditions, not award approval, funding or deadlines.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_CFDB4D9A-D689-49DC-AEC7-37E0BF99519B" name="isEligible" typeRef="boolean" />
    <dmn:informationRequirement id="_2FB64525-F8AC-4905-9FC3-48CB35B71C33">
      <dmn:requiredDecision href="#_DE2C84D6-294A-453B-94F7-FE5A6DAE6E50" />
    </dmn:informationRequirement>
    <dmn:context id="_39D1A04E-3E5C-4663-8C66-A50013AAEDC6">
      <dmn:contextEntry>
        <dmn:variable id="_3DD73AD4-0840-4F5C-80C8-EB416FD4AD24" name="checksAsList" typeRef="BDT.tBooleanList" />
        <dmn:literalExpression id="_9409C3DF-B665-493F-B3F2-12C425A1F4D2">
          <dmn:text>for check in get entries(checks) return check.value</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_023AA975-33F0-4F62-BCF2-46A31A736821">
          <dmn:text>all(checksAsList)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
