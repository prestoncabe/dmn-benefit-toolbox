meta {
  name: Outside help pays household heating obligation
  type: http
  seq: 32
}

post {
  url: {{host}}/benefits/pa/liheap
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPennsylvania": true,
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": {
        "paLiheap": {
          "annualIncome": 0,
          "householdSize": 1
        }
      },
      "heating": {
        "responsibleForSeparatePrimaryHeatingCosts": true,
        "heatIncludedInRent": false
      },
      "household": {
        "hasLiheapEligibleMember": true
      },
      "assistanceHistory": {
        "paLiheap": {
          "received": false
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checks.HeatingCosts: eq true
  res.body.isEligible: eq true
}
