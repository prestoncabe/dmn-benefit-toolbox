meta {
  name: Approved hardship without numeric income
  type: http
  seq: 24
}

post {
  url: {{host}}/benefits/pa/phl/tiered-assistance-program
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": [],
      "waterHardship": {
        "claimed": true,
        "approved": true
      },
      "utilityAccounts": {
        "pwd": {
          "residential": true,
          "applicantIsCustomer": true,
          "occupiesServiceAddress": true
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq true
}
