  <dmn:decision id="_3E90DC49-3DE7-44F6-A549-22B062E47081" name="checkResult">
    <dmn:description>Reads heating.liheapArrangementVerified. Verification covers FY2027 Appendix B §601.31 dwelling, heating-source/code and third-party payment restrictions. It must not mean merely that the household has a heating bill. Leave unanswered until unusual subsidized, institutional, shared-cost or code cases are resolved; missing review remains null. Policy review 2026-10-15.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="FY2027 LIHEAP final state plan — Appendix B, §§601.31, 601.41, 601.81–84" url="https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf" />
    </dmn:extensionElements>
    <dmn:variable id="_4F7D1647-6787-40DC-BDB6-1236FEBAB7E4" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_C92F1DC1-AB65-4ECC-B300-BA7643943759">
      <dmn:requiredInput href="#_F17F0FF4-5DDC-49FB-A775-64157096A6FB" />
    </dmn:informationRequirement>
    <dmn:literalExpression id="_9BDAE8FD-A1A9-4BBF-8E5C-09608A4A1FD0">
      <dmn:text>situation.heating.liheapArrangementVerified</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_F17F0FF4-5DDC-49FB-A775-64157096A6FB" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
