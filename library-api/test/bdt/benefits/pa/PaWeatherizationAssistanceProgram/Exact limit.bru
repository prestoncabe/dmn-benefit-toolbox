meta {
  name: Exact limit
  type: http
  seq: 4
}

post {
  url: {{host}}/benefits/pa/weatherization-assistance-program
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "simpleChecks": {
        "livesInPennsylvania": true,
        "livesInPhiladelphiaPa": true
      },
      "asOfDate": "2026-10-15",
      "incomeAssessments": [
        {
          "basis": "pa-wap",
          "annualIncome": 31920.0,
          "householdSize": 1
        }
      ],
      "dwelling": {
        "occupiesHome": true,
        "tenure": "owner",
        "buildingEligibilityVerified": true,
        "previouslyWeatherized": false
      },
      "household": {
        "wapCategoricalEnrollment": {
          "verified": false
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq true
}
