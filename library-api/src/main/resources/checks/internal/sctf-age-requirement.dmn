    <dmn:knowledgeRequirement id="_90E90B2C-F045-4636-BFBA-582EBF028C9A">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_C189BB80-C23E-476E-B0BB-DDF4FF7D305A#_6E428234-5215-4D38-AB4E-9083E80882D4"/>
    </dmn:knowledgeRequirement>
    <dmn:context id="_FF052B53-7815-4E78-AA54-E848A9E22DDC">
      <dmn:contextEntry>
        <dmn:variable id="_2A350996-32D0-4AC5-862E-29B0151014D4" name="PrimaryPerson65PlusThisYear" typeRef="boolean"/>
        <dmn:literalExpression id="_3D699621-890F-4FF5-A681-60FE6AD298F2">
          <dmn:text>PersonMinAge.PersonMinAgeService(situation: situation, parameters: { personId: situation.primaryPersonId, minAge: 65, asOfDate: date(today().year, 12, 31) })</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_3A556851-307A-4D28-A6EC-9725095591A1" name="PrimaryPerson50PlusThisYear" typeRef="boolean"/>
        <dmn:literalExpression id="_B669E583-BB97-4CAA-A402-DEF9B366DE5B">
          <dmn:text>PersonMinAge.PersonMinAgeService(situation: situation, parameters: { personId: situation.primaryPersonId, minAge: 50, asOfDate: date(today().year, 12, 31) })</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_8E99E291-6D59-4FEA-BDB9-CD4183645A13" name="PrimarySpouse65PlusThisYear" typeRef="boolean"/>
        <dmn:literalExpression id="_04877114-6AC3-4B39-8E5A-CF13EBA2CBE0">
          <dmn:text>PersonMinAge.PersonMinAgeService(situation: situation, parameters: { personId: BDT.spouse id(situation.relationships, situation.primaryPersonId), minAge: 65, asOfDate: date(today().year, 12, 31) })</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_0A921B95-0B16-49B7-BC81-488641C9C798" name="LateSpouseWasAtLeast65" typeRef="boolean"/>
        <dmn:literalExpression id="_B3B1DC6C-4E75-463D-97F2-C53D2E2A020F">
          <dmn:text>situation.simpleChecks.lateSpouseWasAtLeast65</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_04B4CC0C-D9C5-4080-8AFF-50A12285FBEC" name="result" typeRef="boolean"/>
        <dmn:literalExpression id="_F13F433B-FE49-475C-981C-D23B1533DBB7">
          <dmn:text>PrimaryPerson65PlusThisYear or PrimarySpouse65PlusThisYear or (PrimaryPerson50PlusThisYear and LateSpouseWasAtLeast65)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_39438FCA-9EFB-4208-A145-2FA5128C536A">
          <dmn:text>result</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
