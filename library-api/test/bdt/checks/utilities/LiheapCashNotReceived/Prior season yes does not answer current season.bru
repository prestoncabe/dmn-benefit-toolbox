meta {
  name: Prior season yes does not answer current season
  type: http
  seq: 7
}

post {
  url: {{host}}/checks/utilities/liheap-cash-not-received
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "assistanceHistory": {
        "paLiheap": {
          "heatingSeason": "2025-26",
          "receivedRegularCash": true
        }
      }
    },
    "parameters": {
      "heatingSeason": "2026-27"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq null
}
