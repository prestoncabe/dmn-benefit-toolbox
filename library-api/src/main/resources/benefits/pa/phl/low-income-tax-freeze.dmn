  <dmn:decision id="_1760756A-EBB4-428B-BD6F-D9806AA2C2CB" name="nextSteps">
    <dmn:description>Application instructions and help contacts. Constant content, independent of screening answers.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_449D3B8D-0456-4E45-95AA-D1F0140BCCD6" name="nextSteps" typeRef="BDT.tNextSteps"/>
    <dmn:literalExpression id="_7E27CFA9-AEEF-42D9-904F-C8C46700DAC8">
      <dmn:text>{
  eligible: {
    applyUrl: "https://tax-services.phila.gov/_/",
    helpUrl: "https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/get-real-estate-tax-relief/tax-freeze/apply-for-the-low-income-real-estate-tax-freeze/",
    helpPhone: "(215) 686-6442",
    body: "Apply through the Philadelphia Tax Center using the combined real estate assistance application. You do not need an online account. The program page also explains how to apply by mail or in person.\n\n- Apply by September 30 each year.\n- Include copies of proof of income, identity, and residence. Include your spouse's income documents if you are married.\n- You can receive this freeze together with the Homestead Exemption."
  },
  ineligible: {
    note: "This tax freeze has no age requirement. Check the program page or contact the Department of Revenue if you need help documenting your income or residence."
  }
}</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
