    <dmn:description>Minimal local projection for ApplicantOrSpouseMinAge. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_3F4CF5DE-600A-4B77-B790-A0382D738135" name="primaryPersonId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_41C67FF7-6768-47B1-8423-BA2778A51541" name="people" isCollection="false">
      <dmn:typeRef>tPersonList</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_064508C2-6CA3-4F7E-8F6E-A0615DC79182" name="relationships" isCollection="false">
      <dmn:typeRef>BDT.tRelationshipList</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_FCAC80D3-EC40-4FBB-8B54-840CAB7F4CD2" name="simpleChecks" isCollection="false">
      <dmn:typeRef>tSimpleChecks</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_7FC3ED7A-01AF-4090-BE82-09C00EC7D02F" name="tSimpleChecks" isCollection="false">
    <dmn:description>Minimal local projection for ApplicantOrSpouseMinAge. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_426F0F8E-CB1E-48BE-A393-055A24BE177A" name="spouseLivesInHousehold" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_E6628D9C-21F2-4CB1-8A81-FA6A0CC51F45" name="tPerson" isCollection="false">
    <dmn:description>Minimal local projection for ApplicantOrSpouseMinAge. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_E0419FF2-5364-4F18-AC74-FD6E1E2F119B" name="id" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_64D8ABCD-A372-45BA-8499-8C68FA39C0EB" name="dateOfBirth" isCollection="false">
      <dmn:typeRef>date</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_BA524D95-39FF-4A56-8509-15DCE7888E93" name="tPersonList" isCollection="true">
    <dmn:description>Minimal local projection for ApplicantOrSpouseMinAge. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:typeRef>tPerson</dmn:typeRef>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_57BFCDE6-E0DE-4AC9-8B96-3C122B32F3CC" name="tParameters" isCollection="false">
    <dmn:description>Caller-supplied rule parameters. These configure this reusable comparison; consuming benefits own policy-specific values.</dmn:description>
    <dmn:itemComponent id="_5E0F246C-0606-4FFE-85A9-33C43C853119" name="minAge" isCollection="false">
      <dmn:description>Inclusive minimum completed age in years, chosen by the consuming program.</dmn:description>
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_6A22FC6F-9E65-48FF-A538-7A886D125EDA" name="ApplicantOrSpouseMinAgeService">
    <dmn:extensionElements />
    <dmn:variable id="_F57EF21A-106C-4886-82A2-FBFC691F4878" name="ApplicantOrSpouseMinAgeService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_6883DA3C-4BFB-4A45-9B4D-FE7875586354" />
    <dmn:inputData href="#_7EF427A7-D97C-4123-B88C-A2F1D1B670FB" />
    <dmn:inputData href="#_63F66303-A72B-4135-9DA4-EC9C94A6BA03" />
  </dmn:decisionService>
  <dmn:decision id="_6883DA3C-4BFB-4A45-9B4D-FE7875586354" name="checkResult">
    <dmn:description>Uses primaryPersonId and the first outgoing spouse relationship returned by BDT.spouse id. The spouse route additionally requires spouseLivesInHousehold. An empty relationships list establishes no spouse; omitted relationships mean unknown. FEEL OR allows a known passing applicant to establish true while the spouse route is unknown. Caller minAge supplies the threshold. This check uses today() rather than situation.asOfDate. It implements the RETIP spouse route; no late-spouse pathway is included.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="Philadelphia Real Estate Tax Installment Plan — senior and income routes" url="https://www.phila.gov/services/payments-assistance-taxes/payment-plans-and-assistance-programs/income-based-programs-for-residents/set-up-real-estate-tax-installment-plan/" />
    </dmn:extensionElements>
    <dmn:variable id="_64CFCEC3-B63D-415D-9C26-365F13D16B29" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_FB3A2EE1-93FE-4D39-98AA-5B41355DBE15">
      <dmn:requiredInput href="#_7EF427A7-D97C-4123-B88C-A2F1D1B670FB" />
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_4E4BC718-F6FD-4060-BE3B-DD0C9B48774D">
      <dmn:requiredInput href="#_63F66303-A72B-4135-9DA4-EC9C94A6BA03" />
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_3E8D1F4A-6B2C-4D7E-9A15-C4F0B8E2D961">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79#_14EAB512-0E33-419C-9630-BA0265476B6E" />
    </dmn:knowledgeRequirement>
    <dmn:knowledgeRequirement id="_B6C10AA3-5585-406E-9126-D8EECD54EF6C">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_C189BB80-C23E-476E-B0BB-DDF4FF7D305A#_6E428234-5215-4D38-AB4E-9083E80882D4" />
    </dmn:knowledgeRequirement>
    <dmn:context id="_7E128848-BF94-4783-AF34-03C11BFC1987">
      <dmn:contextEntry>
        <dmn:variable id="_E30F29DB-8CCD-49ED-842B-99D280AA3A2F" name="PrimaryPersonMeetsAge" typeRef="boolean" />
        <dmn:literalExpression id="_45BE8F33-4029-4EF0-BC7B-EFC4F8E21461">
          <dmn:text>if situation.primaryPersonId = null then null else PersonMinAge.PersonMinAgeService(situation: situation, parameters: {personId: situation.primaryPersonId, minAge: parameters.minAge, asOfDate: today()})</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_6A82C1D4-430F-4C3D-907F-CEBB593A0F6F" name="SpouseId" typeRef="string" />
        <dmn:literalExpression id="_C94B6004-5D1D-4AC6-B911-19FB66A315F4">
          <dmn:text>if situation.relationships = null or situation.primaryPersonId = null then null else BDT.spouse id(situation.relationships, situation.primaryPersonId)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_0684D24F-2B84-4680-8F70-7170141007D8" name="SpouseMeetsAge" typeRef="boolean" />
        <dmn:literalExpression id="_D8DE8B0D-A4D8-452E-AFDB-24CC94385E8C">
          <dmn:text>if situation.relationships = null or situation.primaryPersonId = null then null
else if SpouseId = null then false
else situation.simpleChecks.spouseLivesInHousehold and PersonMinAge.PersonMinAgeService(situation: situation, parameters: {personId: SpouseId, minAge: parameters.minAge, asOfDate: today()})</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_7B06421E-934F-46A6-A487-5D55D1C05748">
          <dmn:text>PrimaryPersonMeetsAge or SpouseMeetsAge</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:inputData id="_7EF427A7-D97C-4123-B88C-A2F1D1B670FB" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
