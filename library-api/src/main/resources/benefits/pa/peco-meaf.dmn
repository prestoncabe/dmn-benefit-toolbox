            <dmn:parameter id="_45B69F55-B614-4D8E-B48C-7DDA0E816849" name="parameters" typeRef="HouseholdPovertyIncome.tParameters" />
            <dmn:context id="_6450E466-21D9-4EBC-866D-D5D81B1FC913">
              <dmn:contextEntry>
                <dmn:variable id="_53161972-3BF8-4B84-BFA1-4E662B4EEA18" name="basis" typeRef="string" />
