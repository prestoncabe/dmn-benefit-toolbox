            <kie:width>453</kie:width>
          </kie:ComponentWidths>
          <kie:ComponentWidths dmnElementRef="_0E389038-35B8-42FF-8FAD-4E26290F0B80">
            <kie:width>453</kie:width>
          </kie:ComponentWidths>
