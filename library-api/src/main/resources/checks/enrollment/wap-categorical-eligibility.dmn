        <dc:Bounds x="212.0" y="130" width="160" height="80" />
        <dmndi:DMNLabel />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="_D1F2403A-4480-42BB-AD86-D978BDF9F921" dmnElementRef="_4AAED49E-F006-4841-A97A-E43CB191C1F0" isCollapsed="false">
        <dc:Bounds x="212.0" y="480" width="160" height="80" />
        <dmndi:DMNLabel />
