<?xml version='1.0' encoding='UTF-8'?>
<dmn:definitions xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:kie="https://kie.org/dmn/extensions/1.0" id="_9BA070E9-D072-4278-92F2-D928A423ADC2" name="LoopIncome" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_E6D4D573-2C2C-4EE3-BC52-4351F39E5E06" xmlns="https://kie.apache.org/dmn/_E6D4D573-2C2C-4EE3-BC52-4351F39E5E06" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/" xmlns:included1="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" xmlns:included2="https://kie.apache.org/dmn/_F930BB06-CFFE-48AB-B56B-9555274FA2B5">
  <dmn:description>Compare new LOOP applicant household income with the strict 120% AMI table, sizes 1–10.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="Philadelphia LOOP — new applicants, assessment increases, income and exclusions" url="https://www.phila.gov/services/payments-assistance-taxes/payment-plans-and-assistance-programs/income-based-programs-for-residents/apply-for-the-longtime-owner-occupants-program-loop/" />
  </dmn:extensionElements>
  <dmn:import id="_37A3A7B5-3977-439C-AB99-F028623998A6" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:import id="_294E49EF-533A-41AA-906B-A4C1BE010574" name="Income" namespace="https://kie.apache.org/dmn/_F930BB06-CFFE-48AB-B56B-9555274FA2B5" locationURI="Income.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:itemDefinition id="_858203ED-D076-4F08-9C9E-2A9D14FA7AC8" name="tSituation" isCollection="false">
    <dmn:description>Minimal local projection for LoopIncome. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_989AEB94-CD9C-4052-BE44-EBA0F0A83727" name="householdIncome" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_611F50EA-85A9-4609-9401-9E090ED9FEED" name="householdSize" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_17B4DC5A-D23D-4116-9163-BE57C068D80E" name="LoopIncomeService">
    <dmn:extensionElements />
    <dmn:variable id="_A551B9F6-9B1A-47F9-8B8B-608BC9C8393A" name="LoopIncomeService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_9F9451CA-C707-461A-81C1-EF816A8B4FFA" />
    <dmn:inputData href="#_E83712B9-7AAF-49CF-B844-2C81414375AB" />
  </dmn:decisionService>
  <dmn:decision id="_9F9451CA-C707-461A-81C1-EF816A8B4FFA" name="checkResult">
    <dmn:description>Uses the existing Income.below household income limit helper: exact-limit income fails, negative/missing income or noninteger/out-of-range household size returns null. The stored annual dollar table is [103050,117800,132500,147200,159000,170800,182550,194350,206100,217900], recorded as verified 2026-10-05 and matched to the City page checked 2026-10-17. It is not effective-dated and does not extrapolate beyond ten people. Pre-2023 renewal limits differ; do not use this check for those renewals. Review the source and boundary tests before a table update.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="Philadelphia LOOP — new applicants, assessment increases, income and exclusions" url="https://www.phila.gov/services/payments-assistance-taxes/payment-plans-and-assistance-programs/income-based-programs-for-residents/apply-for-the-longtime-owner-occupants-program-loop/" />
    </dmn:extensionElements>
    <dmn:variable id="_3828A95E-2F80-4784-8D1B-90C71CF485AA" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_0E9CC6C5-07AB-4EC9-8985-6EA4230EDC30">
      <dmn:requiredInput href="#_E83712B9-7AAF-49CF-B844-2C81414375AB" />
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_B3E8F1A4-7C26-4D95-8A0B-2E6D9C4F1A57">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_F930BB06-CFFE-48AB-B56B-9555274FA2B5#_2C8F5A13-94D6-4E7B-B1A0-6F3E8D2C7B95" />
    </dmn:knowledgeRequirement>
    <dmn:literalExpression id="_BA464CDF-932F-42BB-9D23-EE8B90076A3C">
      <dmn:text>Income.below household income limit(situation.householdIncome, situation.householdSize, [103050, 117800, 132500, 147200, 159000, 170800, 182550, 194350, 206100, 217900])</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_E83712B9-7AAF-49CF-B844-2C81414375AB" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_B3AB25AF-8194-4BA9-962E-E301D11EE4BD" name="situation" typeRef="tSituation" />
  </dmn:inputData>
  <dmn:textAnnotation id="_CBCC0772-A4EF-474B-9811-491310BED2CB" textFormat="text/plain">
    <dmn:text>New applicants only. Strict income &lt; cap; household sizes 1–10. This table has no effective-date input; review it before reuse for another policy year.</dmn:text>
  </dmn:textAnnotation>
