          <kie:ComponentWidths dmnElementRef="_1C756AB3-A8AA-4D6B-884A-8A241B155DB2">
            <kie:width>917</kie:width>
          </kie:ComponentWidths>
          <kie:ComponentWidths dmnElementRef="_D2023B5D-B8F0-4E0D-B098-FACC423B08A4">
            <kie:width>917</kie:width>
          </kie:ComponentWidths>
        </kie:ComponentsWidthsExtension>
      </di:extension>
      <dmndi:DMNShape id="_0714DF9C-CEBC-4EDB-BE65-4650151C6D04" dmnElementRef="_A7F36AA9-F403-4E02-AC9D-5DBBF329D2AA" isCollapsed="false">
