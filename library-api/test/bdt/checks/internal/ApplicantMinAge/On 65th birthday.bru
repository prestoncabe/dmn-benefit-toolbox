meta {
  name: On 65th birthday
  type: http
  seq: 5
}

post {
  url: {{host}}/checks/internal/applicant-min-age
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "primaryPersonId": "p1",
      "people": [
        {
          "id": "p1",
          "dateOfBirth": "1961-10-15"
        }
      ]
    },
    "parameters": {
      "minAge": 65,
      "asOfDate": "2026-10-15"
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
