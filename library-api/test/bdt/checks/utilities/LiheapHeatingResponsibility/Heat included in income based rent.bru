meta {
  name: Heat included in income based rent
  type: http
  seq: 7
}

post {
  url: {{host}}/checks/utilities/liheap-heating-responsibility
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "heating": {
        "responsibleForSeparatePrimaryHeatingCosts": false,
        "heatIncludedInRent": true,
        "rentBasedOnIncome": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq false
}
