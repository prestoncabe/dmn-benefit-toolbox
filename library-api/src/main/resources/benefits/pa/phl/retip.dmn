  <dmn:decision id="_0BCEA4FF-BB5F-44CE-B735-BAFA2B69A83A" name="isEligible">
    <dmn:description>Aggregate named check results with FEEL all: any false yields false; otherwise unresolved checks yield null; all true yields true. This covers only implemented screening conditions, not award approval, funding or deadlines.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_4EB7A683-37C1-4D22-A04B-8CD04FE8C932" name="isEligible" typeRef="boolean" />
    <dmn:informationRequirement id="_D089FEED-9BD9-4640-9F21-240C7D59915F">
      <dmn:requiredDecision href="#_428EC775-E989-4EF3-ACDA-879F82AFAC31" />
    </dmn:informationRequirement>
    <dmn:context id="_6085E5E6-E9C1-4C1C-B920-4F19A722A103">
      <dmn:contextEntry>
        <dmn:variable id="_6C8FADF9-0CCA-4EBD-8337-B0D220357FA8" name="checksAsList" typeRef="BDT.tBooleanList" />
        <dmn:literalExpression id="_FEF0B024-0421-4715-BAAE-D0F85C07A4C9">
          <dmn:text>for check in get entries(checks) return check.value</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_B859D626-7069-4B2D-8990-F0538DC0554B">
          <dmn:text>all(checksAsList)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
