<?xml version='1.0' encoding='UTF-8'?>
<dmn:definitions xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:kie="https://kie.org/dmn/extensions/1.0" id="_8F26272A-C871-40E7-887E-4AA84F9B2916" name="LiheapCashNotReceived" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_789A4EE7-22B1-47EB-BDDC-268FFB9E1C0A" xmlns="https://kie.apache.org/dmn/_789A4EE7-22B1-47EB-BDDC-268FFB9E1C0A" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/" xmlns:included1="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" xmlns:included2="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C">
  <dmn:description>Screen for a regular LIHEAP Cash grant not yet received for the explicitly named heating season.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="FY2027 LIHEAP final state plan — Appendix B, §§601.6, 601.43–44" url="https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf" />
  </dmn:extensionElements>
  <dmn:import id="_BAC7FDB2-5094-4B63-BA08-60A618B93D79" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:import id="_212F493C-699C-457D-8E82-A6C0CE91CD90" name="Utilities" namespace="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C" locationURI="Utilities.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:itemDefinition id="_9453EB34-1EE1-401A-8AAD-DFE4B6276357" name="tParameters" isCollection="false">
    <dmn:description>Caller-supplied rule parameters. These configure this reusable comparison; consuming benefits own policy-specific values.</dmn:description>
    <dmn:itemComponent id="_17AD4149-BE6D-408F-83C8-9870E809A999" name="heatingSeason" isCollection="false">
      <dmn:description>Heating season being screened, in YYYY-YY form. Supplied explicitly by the consuming benefit, for example 2026-27; no date-based default. The receipt answer must refer to this same season.</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_F858055F-70FE-4F66-96A3-8FC4D977B55B" name="tSituation" isCollection="false">
    <dmn:description>Minimal local projection for LiheapCashNotReceived. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_50E1F672-8FE7-4584-BA6A-E5DA1F65ECFA" name="assistanceHistory" isCollection="false">
      <dmn:typeRef>tAssistanceHistory</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_D4F47CCE-9D55-4F6B-A775-B651E923B874" name="tLiheapSeasonHistory" isCollection="false">
    <dmn:description>Minimal local projection for LiheapCashNotReceived; uses canonical BDT.tLiheapSeasonHistory field meanings.</dmn:description>
    <dmn:itemComponent id="_B3796043-9213-4BED-B4F6-6D53C19848FC" name="heatingSeason" isCollection="false">
      <dmn:description>Heating season the answer refers to, in YYYY-YY form (for example 2026-27). The screener must display this season in the receipt question. A saved answer for another season must be asked again; do not infer the season from a payment date.</dmn:description>
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_DCA1B02F-07C7-4519-8CA9-068CB749A30B" name="receivedRegularCash" isCollection="false">
      <dmn:description>Has your household already received its regular LIHEAP Cash heating grant for the named heating season? True means yes, false means no, and missing/null means unsure. Count a payment to the utility or fuel provider on the household's behalf. An application merely submitted, a Crisis grant, and a previous season's grant do not mean yes. Supplemental awards are handled by the agency; this question screens for another regular Cash grant.</dmn:description>
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_31FF75DB-EE50-44FF-88BD-022955586ABE" name="tAssistanceHistory" isCollection="false">
    <dmn:description>Minimal local projection for LiheapCashNotReceived. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_4841A483-2096-4B2C-910C-0D39008D2938" name="paLiheap" isCollection="false">
      <dmn:typeRef>tLiheapSeasonHistory</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_B0BD52F8-BA40-4541-B10D-7ED4E02E7EF3" name="LiheapCashNotReceivedService">
    <dmn:extensionElements />
    <dmn:variable id="_94142168-336E-4F4D-944C-481AE3BE0C7A" name="LiheapCashNotReceivedService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_151B8A41-E43C-4048-ACA5-3700977E52A6" />
    <dmn:inputData href="#_3B76752A-D10D-4B91-941A-BEAE0822A90B" />
    <dmn:inputData href="#_6B05F0D6-318D-4098-945F-1230CBA45B6C" />
  </dmn:decisionService>
  <dmn:decision id="_151B8A41-E43C-4048-ACA5-3700977E52A6" name="checkResult">
    <dmn:description>For parameters.heatingSeason, ask: Has your household already received its regular LIHEAP Cash heating grant for [heating season]? A matching season and receivedRegularCash=false pass; true fails another regular Cash application; missing/null answer or missing/mismatched season remains unknown. Do not substitute lifetime receipt, application submission, payment dates, Crisis assistance or a previous season. Cash paid to a provider counts as received. The benefit supplies its plan-specific season explicitly; neither today nor October 1 selects the season. Previously saved answers require renewal for a new season. Supplements and final verification remain with the agency. Crisis does not use this Cash exclusion. FY2027 Appendix B §§601.6, 601.43–44. Policy reviewed 2026-10-22; replaces the date-proxy interpretation reviewed 2026-10-15.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="FY2027 LIHEAP final state plan — Appendix B, §§601.6, 601.43–44" url="https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf" />
    </dmn:extensionElements>
    <dmn:variable id="_26E758F3-616E-4415-90A2-D406A7FD851F" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_1E4D2DA8-264C-44EE-91DC-31621323E814">
      <dmn:requiredInput href="#_3B76752A-D10D-4B91-941A-BEAE0822A90B" />
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_2382CA0D-B6D7-48FC-994C-DEC9719431D1">
      <dmn:requiredInput href="#_6B05F0D6-318D-4098-945F-1230CBA45B6C" />
    </dmn:informationRequirement>
    <dmn:literalExpression id="_F6C2C6F8-34F6-4A79-B9D8-AED300F04ECB">
      <dmn:text>if parameters.heatingSeason = null or parameters.heatingSeason = "" then null
else if situation.assistanceHistory.paLiheap.heatingSeason = null
  or situation.assistanceHistory.paLiheap.heatingSeason != parameters.heatingSeason then null
else not(situation.assistanceHistory.paLiheap.receivedRegularCash)</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_3B76752A-D10D-4B91-941A-BEAE0822A90B" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_E994AB95-3A51-456B-9AFF-067ACE382BD2" name="situation" typeRef="tSituation" />
  </dmn:inputData>
  <dmn:inputData id="_6B05F0D6-318D-4098-945F-1230CBA45B6C" name="parameters">
    <dmn:description>Caller-supplied parameters; see the associated type and rule description for its contract.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_9ADBECC7-37AF-4831-8D55-B31230AD0FEF" name="parameters" typeRef="tParameters" />
  </dmn:inputData>
