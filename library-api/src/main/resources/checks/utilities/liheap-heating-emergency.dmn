  <dmn:description>Require a qualifying LIHEAP heating emergency AND verified resolution within available resources.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="FY2027 LIHEAP final state plan — Appendix B, §§601.31, 601.41, 601.81–84" url="https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf" />
  </dmn:extensionElements>
  <dmn:import id="_13B8A577-B6D6-4CBC-A05C-4635A62DD7FA" name="BDT" namespace="https://kie.apache.org/dmn/_1B91A885-130A-4E0B-A762-E12AA6DD5C79" locationURI="../../BDT.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:import id="_7183B919-F512-4DE8-ADBF-4E3173B2DEF5" name="Utilities" namespace="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C" locationURI="Utilities.dmn" importType="https://www.omg.org/spec/DMN/20240513/MODEL/" />
  <dmn:itemDefinition id="_5E7AD8C6-9D5C-411E-AF6D-5F06FB5A74AF" name="tSituation" isCollection="false">
    <dmn:description>Minimal local projection for LiheapHeatingEmergency. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_DE96ED53-6A28-435E-B90C-3DC0F01F4F7C" name="heating" isCollection="false">
      <dmn:typeRef>tHeating</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_6D61D0B0-D3AD-4DBF-804E-B64C8289941B" name="tHeating" isCollection="false">
    <dmn:description>Minimal local projection for LiheapHeatingEmergency. Reuse the canonical field meanings in BDT.dmn or Enrollment.dmn; only fields consumed by this model are included.</dmn:description>
    <dmn:itemComponent id="_DD0029B3-922E-4064-B75A-11F28F2BD8B8" name="equipmentBroken" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_D23CB211-8A89-4232-9B7E-BBA2872E1187" name="fuelLinesLeaking" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_922F6CC8-A80E-4241-8C5E-EBEAD1B6EC82" name="fuelDaysRemaining" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_F5E35675-6B4C-4EBA-8AEB-172692068239" name="heatingServiceDisconnected" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_3801E893-380B-4304-9216-0BA1097DAE1B" name="terminationNotice" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_51A1313E-BFE1-4360-BD5B-C9CD8D9B3A12" name="daysUntilTermination" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_593F851F-AE0B-4888-AEDB-762F1A73A8D5" name="terminationPermitted" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_3C4F056D-4FBD-47BA-8A85-2E5F292C2E2F" name="crisisResolutionVerified" isCollection="false">
      <dmn:typeRef>boolean</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:decisionService id="_93A29957-AFFD-48BD-9AFD-D75087A523C8" name="LiheapHeatingEmergencyService">
    <dmn:extensionElements />
    <dmn:variable id="_9366D0DD-6A68-4256-8D72-3616C9D01F2C" name="LiheapHeatingEmergencyService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_4199CD1B-D419-4C48-8E2A-FAF8F1C17512" />
    <dmn:inputData href="#_517FF71E-34DB-4BF6-A759-E22E1AAF1E2E" />
  </dmn:decisionService>
  <dmn:decision id="_4199CD1B-D419-4C48-8E2A-FAF8F1C17512" name="checkResult">
    <dmn:description>Alternatives are broken heating equipment, leaking fuel lines, disconnected qualifying service, fuel supply strictly under 15 days, or a valid permitted termination notice within 60 days inclusive. Negative or unknown day counts are unresolved. terminationPermitted includes authorization under winter protections. crisisResolutionVerified records proof and a package resolving the emergency within benefit limits using available vendor credits and other resources; it is separate from funding reservations. Unknown resolution cannot establish eligibility. Policy review 2026-10-15.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="FY2027 LIHEAP final state plan — Appendix B, §§601.31, 601.41, 601.81–84" url="https://www.pa.gov/content/dam/copapwp-pagov/en/dhs/documents/services/assistance/documents/heating-assistance_liheap/2027-liheap-state-plan.pdf" />
    </dmn:extensionElements>
    <dmn:variable id="_3EF40B9B-FBBA-495C-B3B3-13418C87D589" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_D4632DE2-4074-4C5E-8C41-24E39ED1E9BA">
      <dmn:requiredInput href="#_517FF71E-34DB-4BF6-A759-E22E1AAF1E2E" />
    </dmn:informationRequirement>
    <dmn:literalExpression id="_4ACEEA57-ECAE-4A74-917A-062F6A713040">
      <dmn:text>(situation.heating.equipmentBroken or situation.heating.fuelLinesLeaking or situation.heating.heatingServiceDisconnected or
 (if situation.heating.fuelDaysRemaining = null or situation.heating.fuelDaysRemaining &lt; 0 then null else situation.heating.fuelDaysRemaining &lt; 15) or
 (situation.heating.terminationNotice and situation.heating.terminationPermitted and (if situation.heating.daysUntilTermination = null or situation.heating.daysUntilTermination &lt; 0 then null else situation.heating.daysUntilTermination &lt;= 60)))
and situation.heating.crisisResolutionVerified</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
  <dmn:inputData id="_517FF71E-34DB-4BF6-A759-E22E1AAF1E2E" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_0D4815BF-5578-49A5-A555-865C5A962F8E" name="situation" typeRef="tSituation" />
  </dmn:inputData>
  <dmn:textAnnotation id="_13A4E3F3-6DE8-4EB7-8184-D69F3BB9D01D" textFormat="text/plain">
    <dmn:text>Emergency thresholds: fuel &lt; 15 days; permitted termination ≤ 60 days. A qualifying emergency also needs verified resolution; unknown approval stays unknown.</dmn:text>
  </dmn:textAnnotation>
