meta {
  name: One cent above limit
  type: http
  seq: 5
}

post {
  url: {{host}}/benefits/pa/peco-meaf
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "asOfDate": "2026-10-15",
      "incomeAssessments": {
        "pecoMeaf": {
          "annualIncome": 31920.01,
          "householdSize": 1
        }
      },
      "utilityAccounts": {
        "peco": {
          "residential": true,
          "applicantIsCustomer": true,
          "occupiesServiceAddress": true,
          "serviceTerminated": false,
          "imminentTermination": true,
          "balanceResolutionVerified": true
        }
      },
      "assistanceHistory": {
        "paPecoMeaf": {
          "received": false
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.isEligible: eq false
}
