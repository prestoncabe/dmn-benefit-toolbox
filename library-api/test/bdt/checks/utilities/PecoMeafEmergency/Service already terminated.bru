meta {
  name: Service already terminated
  type: http
  seq: 9
}

post {
  url: {{host}}/checks/utilities/peco-meaf-emergency
  body: json
  auth: inherit
}

body:json {
  {
    "situation": {
      "asOfDate": "2026-10-15",
      "assistanceHistory": [],
      "utilityAccounts": {
        "peco": {
          "residential": true,
          "applicantIsCustomer": true,
          "occupiesServiceAddress": true,
          "serviceTerminated": true,
          "imminentTermination": false,
          "balanceResolutionVerified": true
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.checkResult: eq true
}
