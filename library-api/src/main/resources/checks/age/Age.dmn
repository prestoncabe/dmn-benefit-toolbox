<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" xmlns="https://kie.apache.org/dmn/_81D401A8-CA81-4F9A-ABCC-532C25768708" xmlns:feel="https://www.omg.org/spec/DMN/20240513/FEEL/" xmlns:kie="https://kie.org/dmn/extensions/1.0" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="_238F82CA-D3A4-458D-992B-0ED2D9FA9952" name="Age" typeLanguage="https://www.omg.org/spec/DMN/20240513/FEEL/" namespace="https://kie.apache.org/dmn/_81D401A8-CA81-4F9A-ABCC-532C25768708">
  <dmn:description>Shared age calculation in completed years between a birth date and comparison date. Technical primitive, not a program age policy. Callers choose the comparison date and threshold. The helper returns -1 for a missing date; callers determine whether that means false or unknown. Program-specific calendar-year and spouse rules live in consuming checks.</dmn:description>
  <dmn:extensionElements>
    <kie:attachment name="OMG DMN 1.6 — FEEL and model semantics" url="https://www.omg.org/spec/DMN/1.6/" />
  </dmn:extensionElements>
  <dmn:businessKnowledgeModel id="_1919D943-09A4-4D5C-98A0-2B8377862E4C" name="as of date">
    <dmn:description>Computes completed years via years and months duration between the supplied dates. Returns -1 if either is missing. It does not default dates, validate program age thresholds or convert missing evidence into a standard check result.</dmn:description>
    <dmn:extensionElements/>
    <dmn:variable id="_BE3DFD22-F76F-4C29-B80C-745A01A88670" name="as of date" typeRef="number"/>
    <dmn:encapsulatedLogic id="_585A271E-C315-41D7-99C8-830B085BE8F0" kind="FEEL">
      <dmn:formalParameter id="_BB103AA1-0552-4B55-B1CF-75B4BC080DF4" name="date of birth" typeRef="date"/>
      <dmn:formalParameter id="_BB4067B5-626D-49DF-A542-B29036FAF633" name="comparison date" typeRef="date"/>
      <dmn:literalExpression id="_E4B71B0A-EA55-438B-9481-716B560FD05A">
        <dmn:text>if date of birth = null or comparison date = null then
  -1
else
  (for age duration in [years and months duration(date(date of birth), date(comparison date))] return age duration.years)[1]</dmn:text>
      </dmn:literalExpression>
    </dmn:encapsulatedLogic>
  </dmn:businessKnowledgeModel>
  <dmn:textAnnotation id="_750932D0-B998-4223-8D9C-25FC20A91A61" textFormat="text/plain">
    <dmn:text>BKMs, data types, and/or Decision Services that will be included in every eligibility check categorized as "Age"</dmn:text>
  </dmn:textAnnotation>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="_C61A36F6-4E4D-4397-9308-6CECE630DE23" name="DRG">
