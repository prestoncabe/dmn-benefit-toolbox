  <dmn:decisionService id="_0897D6F6-C34A-48A6-9842-E4B0F42BB0BF" name="PecoMeafEmergencyService">
    <dmn:extensionElements />
    <dmn:variable id="_305964E1-B637-46B3-A886-D85DBB4C5F60" name="PecoMeafEmergencyService" typeRef="BDT.tCheckResponse" />
    <dmn:outputDecision href="#_BD4592FC-244F-42B1-BF2B-B82B1C3E8C3F" />
    <dmn:inputData href="#_6DEE83AD-4B07-4CEE-BF36-13AD6DE957BA" />
  </dmn:decisionService>
  <dmn:decision id="_BD4592FC-244F-42B1-BF2B-B82B1C3E8C3F" name="checkResult">
    <dmn:description>The same responsible residential PECO account, utilityAccounts.peco, must be already terminated OR face imminent termination and have balanceResolutionVerified=true. That verification means the grant/payment package brings the balance to zero, not that funds are reserved. Using asOfDate or today(), exclude PaPecoMeaf grants strictly newer than the date minus P12M; the twelve-month anniversary is allowed. Missing history, unknown receipt dates or future dates remain unresolved. An empty history establishes no recent grant. No unrelated UGP waiting period or local-only exclusion is imported. Policy review 2026-10-15.</dmn:description>
    <dmn:extensionElements>
      <kie:attachment name="PECO MEAF — overview; no detailed rule text rendered at review" url="https://www.peco.com/MyAccount/CustomerSupport/Pages/MEAFOV.aspx" />
      <kie:attachment name="UESF — MEAF Assistance Eligibility section (not UGP rules)" url="https://uesfacts.org/our-programs/utility-grant-program/" />
    </dmn:extensionElements>
    <dmn:variable id="_E8FDB4D9-125E-4D82-A7E9-C12D3C5EA84B" name="checkResult" typeRef="boolean" />
    <dmn:informationRequirement id="_22B62D3F-2CA6-4BE1-9319-8DCA8A6B5762">
      <dmn:requiredInput href="#_6DEE83AD-4B07-4CEE-BF36-13AD6DE957BA" />
    </dmn:informationRequirement>
    <dmn:knowledgeRequirement id="_AC94427A-3BDB-468A-A959-6B4E914D55F7">
      <dmn:requiredKnowledge href="https://kie.apache.org/dmn/_0D766327-3F43-4A00-B3CF-01B6F4BB3C8C#_BDB4C5D2-69EA-43C1-BCA3-07F7C2A9132C" />
    </dmn:knowledgeRequirement>
    <dmn:context id="_312D846A-930E-4FC2-907C-D7911589F4BF">
      <dmn:contextEntry>
        <dmn:variable id="_EBD4D211-E1D7-4F14-BC62-E5DB21CD3CE5" name="comparisonDate" typeRef="date" />
        <dmn:literalExpression id="_9A6F124A-E2F9-4769-94CB-A34B0D2B436D">
          <dmn:text>if situation.asOfDate = null then today() else situation.asOfDate</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_04C3E659-753B-4131-84A5-C93540A31B26" name="noRecentGrant" typeRef="boolean" />
        <dmn:literalExpression id="_2ABA225A-57FA-48A5-A1B9-30658EC29F0B">
          <dmn:text>if situation.assistanceHistory = null then null else not(any(for grant in situation.assistanceHistory return (if grant.program = null then null else grant.program = "PaPecoMeaf") and (if grant.receivedDate = null or date(grant.receivedDate) &gt; comparisonDate then null else date(grant.receivedDate) &gt; comparisonDate - duration("P12M"))))</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:variable id="_2C5F72A2-CDF5-4484-B800-95D5071F6489" name="account" typeRef="tUtilityAccount" />
        <dmn:literalExpression id="_3A0B1484-60B2-4541-834A-513592D87AA9">
          <dmn:text>if situation.utilityAccounts = null then null else situation.utilityAccounts.peco</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_2BA27B3A-1014-4546-9B58-E90FFE4B9BD8">
          <dmn:text>noRecentGrant and Utilities.residential account(account) and (account.serviceTerminated or account.imminentTermination) and account.balanceResolutionVerified</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
  <dmn:inputData id="_6DEE83AD-4B07-4CEE-BF36-13AD6DE957BA" name="situation">
    <dmn:description>Recorded facts projected from the canonical BDT situation. Supply the fields used by this model; see the check decision for missing/invalid-input behavior.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_3BED8319-FB27-4306-A73E-83344FC96D30" name="situation" typeRef="tSituation" />
  </dmn:inputData>
