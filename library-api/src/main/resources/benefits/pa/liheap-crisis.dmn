  <dmn:decision id="_3BD0EA05-9765-4EDC-BDEE-933302F8F1DB" name="isEligible">
    <dmn:description>Aggregate named check results with FEEL all: any false yields false; otherwise unresolved checks yield null; all true yields true. This covers only implemented screening conditions, not award approval, funding or deadlines.</dmn:description>
    <dmn:extensionElements />
    <dmn:variable id="_A437E0C0-C297-4D3C-9127-AB3F7A8868CA" name="isEligible" typeRef="boolean" />
    <dmn:informationRequirement id="_E30C3E2C-2E5B-4D8C-8292-27DE8704AD00">
      <dmn:requiredDecision href="#_81A9E856-333C-42F0-A9DE-3F8B23B00FEF" />
    </dmn:informationRequirement>
    <dmn:context id="_5A01FE61-71F1-4A72-85A1-CC0DEE0ABBFE">
      <dmn:contextEntry>
        <dmn:variable id="_814F5F5E-5CF2-4965-BC76-BB615208765C" name="checksAsList" typeRef="BDT.tBooleanList" />
        <dmn:literalExpression id="_CDE074A6-3BA0-4608-85CD-C25707EE57C4">
          <dmn:text>for check in get entries(checks) return check.value</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry>
        <dmn:literalExpression id="_91DB56CC-8DE2-4148-A403-56C394D96FA2">
          <dmn:text>all(checksAsList)</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
